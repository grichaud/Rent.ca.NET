@page "/{culture:locale}/forgot-password"
@model Rent.Web.Features.Auth.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = L["auth.forgotTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="glass-card p-8 sm:p-10">
    @if (Model.Submitted)
    {
        var emailHtml = $"<strong class=\"text-slate-900 dark:text-white\">{System.Net.WebUtility.HtmlEncode(Model.Input.Email)}</strong>";
        <div class="text-center py-2">
            <div class="mb-4 mx-auto w-16 h-16 rounded-full bg-brand-500/20 flex items-center justify-center">
                <icon name="mail" class="h-8 w-8 text-brand-500 dark:text-brand-400" />
            </div>
            <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white">@L["auth.checkEmailTitle"]</h1>
            <p class="text-slate-500 dark:text-white/60 text-sm mt-2 mb-6">
                @Html.Raw(string.Format(L["auth.checkEmailBody"].Value, emailHtml))
            </p>
            <a href="/@culture/login" class="glass-button-primary inline-flex items-center gap-2 px-6 py-3">@L["auth.backToLogin"]</a>
        </div>
    }
    else
    {
        <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white text-center">@L["auth.forgotTitle"]</h1>
        <p class="text-slate-500 dark:text-white/60 text-center mt-2">
            @L["auth.forgotDesc"]
        </p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" role="alert" class="text-sm text-red-600 dark:text-red-400"></div>

            <div>
                <label asp-for="Input.Email" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.email"]</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                        <icon name="mail" class="h-4 w-4" />
                    </span>
                    <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="@L["auth.emailPlaceholder"]" class="glass-input !pl-10" />
                </div>
                <span asp-validation-for="Input.Email" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
                <icon name="mail" class="h-4 w-4" />
                @L["auth.forgotSubmit"]
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600 dark:text-white/70">
            <a href="/@culture/login" class="inline-flex items-center gap-1.5 text-brand-600 dark:text-brand-400 font-medium hover:underline">
                <icon name="chevron-left" class="h-3.5 w-3.5" />
                @L["auth.backToLogin"]
            </a>
        </p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
