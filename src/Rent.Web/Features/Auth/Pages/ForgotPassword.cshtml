@page "/{culture:locale}/forgot-password"
@model Rent.Web.Features.Auth.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = L["auth.forgotTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-8 sm:p-10">
        <div class="flex justify-center mb-4">
            <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                <icon name="mail" class="h-6 w-6" />
            </div>
        </div>
        <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white text-center">@L["auth.forgotTitle"]</h1>
        <p class="text-slate-500 dark:text-white/60 text-center mt-2">
            @L["auth.forgotDesc"]
        </p>

        @if (Model.Submitted)
        {
            <div class="mt-8 p-4 rounded-xl border border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 text-sm text-slate-700 dark:text-white/80">
                @L["auth.forgotSent"]
            </div>
            <div class="flex gap-3 justify-center mt-6">
                <a href="/@culture/login" class="glass-button">@L["auth.backToLogin"]</a>
            </div>
        }
        else
        {
            <form method="post" class="mt-8 space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.email"]</label>
                    <input asp-for="Input.Email" type="email" class="glass-input" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600 dark:text-red-400"></span>
                </div>

                <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
                    <icon name="mail" class="h-4 w-4" />
                    @L["auth.forgotSubmit"]
                </button>
            </form>

            <div class="flex gap-3 justify-center mt-6 text-sm">
                <a href="/@culture/login" class="text-slate-500 dark:text-white/60 hover:underline">@L["auth.backToLogin"]</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
