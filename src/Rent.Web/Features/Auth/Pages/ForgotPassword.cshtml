@page "/forgot-password"
@model Rent.Web.Features.Auth.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-10 text-center">
        <div class="flex justify-center mb-4">
            <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                <icon name="mail" class="h-6 w-6" />
            </div>
        </div>
        <h1 class="font-display text-3xl text-slate-900 dark:text-white">Password reset</h1>
        <p class="text-slate-500 dark:text-white/60 mt-4">
            Email-based password reset ships in slice 2 together with the Resend integration.
            For this MVP, please contact the site admin or create a new account.
        </p>
        <div class="flex gap-3 justify-center mt-8">
            <a href="/login" class="glass-button">Back to login</a>
            <a href="/signup" class="glass-button-primary">Create account</a>
        </div>
    </div>
</section>
