@page "/reset-password"
@model Rent.Web.Features.Auth.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-8 sm:p-10">
        <div class="flex justify-center mb-4">
            <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                <icon name="lock" class="h-6 w-6" />
            </div>
        </div>
        <h1 class="font-display text-3xl text-slate-900 dark:text-white text-center">Choose a new password</h1>
        <p class="text-slate-500 dark:text-white/60 text-center mt-2">For <strong>@Model.Input.Email</strong></p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400"></div>
            <input type="hidden" asp-for="Input.Email" />
            <input type="hidden" asp-for="Input.Token" />

            <div>
                <label asp-for="Input.Password" class="block text-sm text-slate-700 dark:text-white/80 mb-1">New password</label>
                <input asp-for="Input.Password" type="password" class="glass-input" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-xs text-red-600 dark:text-red-400"></span>
                <p class="text-xs text-slate-500 dark:text-white/50 mt-1">At least 8 characters, one uppercase, one digit.</p>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="glass-input" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
                <icon name="check" class="h-4 w-4" />
                Update password
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
