@page "/{culture:locale}/reset-password"
@model Rent.Web.Features.Auth.Pages.ResetPasswordModel
@{
    ViewData["Title"] = L["auth.resetTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="glass-card p-8 sm:p-10">
    @if (Model.TokenInvalid)
    {
        <div class="text-center py-2">
            <div class="mb-4 mx-auto w-16 h-16 rounded-full bg-red-500/20 flex items-center justify-center">
                <icon name="alert-circle" class="h-8 w-8 text-red-500 dark:text-red-400" />
            </div>
            <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white">@L["auth.linkExpiredTitle"]</h1>
            <p class="text-slate-500 dark:text-white/60 text-sm mt-2 mb-6">@L["auth.linkExpiredBody"]</p>
            <a href="/@culture/forgot-password" class="glass-button-primary inline-flex items-center gap-2 px-6 py-3">@L["auth.requestNewLink"]</a>
        </div>
    }
    else
    {
        <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white text-center">@L["auth.resetTitle"]</h1>
        <p class="text-slate-500 dark:text-white/60 text-center mt-2">@L["auth.resetForEmail"] <strong>@Model.Input.Email</strong></p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" role="alert" class="text-sm text-red-600 dark:text-red-400"></div>
            <input type="hidden" asp-for="Input.Email" />
            <input type="hidden" asp-for="Input.Token" />

            <div>
                <label asp-for="Input.Password" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["renter.accountNewPassword"]</label>
                <div class="relative" data-password-wrap>
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                        <icon name="lock" class="h-4 w-4" />
                    </span>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="@L["auth.passwordPlaceholder"]" class="glass-input !pl-10 !pr-10" />
                    <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                            data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                        <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                        <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
                <p class="text-xs text-slate-500 dark:text-white/50 mt-1">@L["auth.passwordHint"]</p>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.confirmNewPassword"]</label>
                <div class="relative" data-password-wrap>
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                        <icon name="lock" class="h-4 w-4" />
                    </span>
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="@L["auth.passwordPlaceholder"]" class="glass-input !pl-10 !pr-10" />
                    <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                            data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                        <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                        <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
                <icon name="lock" class="h-4 w-4" />
                @L["auth.resetSubmit"]
            </button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
