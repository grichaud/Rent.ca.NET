@page "/login"
@model Rent.Web.Features.Auth.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-8 sm:p-10">
        <h1 class="font-display text-3xl text-slate-900 text-center">Welcome back</h1>
        <p class="text-slate-500 text-center mt-2">Log in to your Rent.ca account.</p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

            <div>
                <label asp-for="Input.Email" class="block text-sm text-slate-700 mb-1">Email</label>
                <input asp-for="Input.Email" type="email" class="glass-input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-sm text-slate-700 mb-1">Password</label>
                <input asp-for="Input.Password" type="password" class="glass-input" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-xs text-red-600"></span>
            </div>

            <label class="inline-flex items-center gap-2 text-sm text-slate-600">
                <input asp-for="Input.RememberMe" type="checkbox" class="rounded border-slate-300" />
                Remember me
            </label>

            <button type="submit" class="glass-button-primary w-full mt-2">Log in</button>
        </form>

        <div class="flex items-center justify-between mt-6 text-sm">
            <a href="/forgot-password" class="text-slate-500 hover:underline">Forgot password?</a>
            <a href="/signup" class="text-brand-600 font-medium hover:underline">Create account</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
