@page "/login"
@model Rent.Web.Features.Auth.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-8 sm:p-10">
        <div class="flex justify-center mb-4">
            <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                <icon name="log-in" class="h-6 w-6" />
            </div>
        </div>
        <h1 class="font-display text-3xl text-slate-900 dark:text-white text-center">Welcome back</h1>
        <p class="text-slate-500 dark:text-white/60 text-center mt-2">Log in to your Rent.ca account.</p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400"></div>

            <div>
                <label asp-for="Input.Email" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Email</label>
                <input asp-for="Input.Email" type="email" class="glass-input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Password</label>
                <input asp-for="Input.Password" type="password" class="glass-input" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <label class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-white/70">
                <input asp-for="Input.RememberMe" type="checkbox" class="rounded border-gray-300 dark:border-white/20 text-brand-500 focus:ring-brand-500" />
                Remember me
            </label>

            <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
                <icon name="log-in" class="h-4 w-4" />
                Log in
            </button>
        </form>

        <div class="flex items-center justify-between mt-6 text-sm">
            <a href="/forgot-password" class="text-slate-500 dark:text-white/60 hover:underline">Forgot password?</a>
            <a href="/signup" class="text-brand-600 dark:text-brand-400 font-medium hover:underline">Create account</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
