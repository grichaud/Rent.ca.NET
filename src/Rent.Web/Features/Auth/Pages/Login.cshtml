@page "/{culture:locale}/login"
@model Rent.Web.Features.Auth.Pages.LoginModel
@{
    ViewData["Title"] = L["common.signIn"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="glass-card p-8 sm:p-10">
    <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white text-center">@L["auth.welcomeBack"]</h1>
    <p class="text-slate-500 dark:text-white/60 text-center mt-2">@L["auth.signInDesc"]</p>

    @if (Model.StatusMessage is not null)
    {
        <div class="mt-4 p-3 rounded-lg border border-red-300 bg-red-50 dark:border-red-500/40 dark:bg-red-500/10 text-sm text-red-700 dark:text-red-300">
            @Model.StatusMessage
        </div>
    }

    @if (Model.SuccessMessage is not null)
    {
        <div class="mt-4 p-3 rounded-lg border border-emerald-300 bg-emerald-50 dark:border-emerald-500/40 dark:bg-emerald-500/10 text-sm text-emerald-700 dark:text-emerald-300">
            @Model.SuccessMessage
        </div>
    }

    <form method="post" class="mt-8 space-y-4">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm text-red-600 dark:text-red-400"></div>

        <div>
            <label asp-for="Input.Email" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.email"]</label>
            <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="mail" class="h-4 w-4" />
                </span>
                <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="@L["auth.emailPlaceholder"]" class="glass-input !pl-10" />
            </div>
            <span asp-validation-for="Input.Email" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <div class="flex items-center justify-between mb-1">
                <label asp-for="Input.Password" class="block text-sm text-slate-700 dark:text-white/80">@L["auth.password"]</label>
                <a href="/@culture/forgot-password" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">@L["auth.forgotPassword"]</a>
            </div>
            <div class="relative" data-password-wrap>
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="lock" class="h-4 w-4" />
                </span>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="@L["auth.passwordPlaceholder"]" class="glass-input !pl-10 !pr-10" />
                <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                        data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                    <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                    <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                </button>
            </div>
            <span asp-validation-for="Input.Password" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </div>

        <button type="submit" class="glass-button-primary w-full inline-flex items-center justify-center gap-2">
            <icon name="log-in" class="h-4 w-4" />
            @L["auth.signInButton"]
        </button>
    </form>

    @if (Model.ExternalLogins.Any())
    {
        <div class="my-6 flex items-center gap-3 text-xs uppercase tracking-wider text-slate-400 dark:text-white/40">
            <span class="flex-1 h-px bg-slate-200 dark:bg-white/10"></span>
            <span>@L["auth.orContinueWith"]</span>
            <span class="flex-1 h-px bg-slate-200 dark:bg-white/10"></span>
        </div>

        <div class="space-y-2">
            @foreach (var scheme in Model.ExternalLogins)
            {
                <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
                    <input type="hidden" name="provider" value="@scheme.Name" />
                    <button type="submit" class="glass-button w-full inline-flex items-center justify-center gap-3" title="@L["auth.continueWithGoogle"]">
                        @if (scheme.Name == "Google")
                        {
                            <partial name="/Features/Auth/Pages/_GoogleIcon.cshtml" />
                        }
                        <span class="font-medium">@L["auth.continueWithGoogle"]</span>
                    </button>
                </form>
            }
        </div>
    }

    <p class="mt-6 text-center text-sm text-slate-600 dark:text-white/70">
        @L["auth.dontHaveAccount"]
        <a href="/@culture/signup" class="text-brand-600 dark:text-brand-400 font-medium hover:underline ml-1">@L["auth.signUpLink"]</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
