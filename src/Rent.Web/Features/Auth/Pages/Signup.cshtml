@page "/signup"
@model Rent.Web.Features.Auth.Pages.SignupModel
@{
    ViewData["Title"] = "Create your account";
}

<section class="max-w-md mx-auto">
    <div class="glass-card p-8 sm:p-10">
        <h1 class="font-display text-3xl text-slate-900 text-center">Create your account</h1>
        <p class="text-slate-500 text-center mt-2">Takes less than a minute.</p>

        <form method="post" class="mt-8 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

            <div>
                <label asp-for="Input.FullName" class="block text-sm text-slate-700 mb-1">Full name</label>
                <input asp-for="Input.FullName" class="glass-input" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Input.Email" class="block text-sm text-slate-700 mb-1">Email</label>
                <input asp-for="Input.Email" type="email" class="glass-input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-sm text-slate-700 mb-1">Password</label>
                <input asp-for="Input.Password" type="password" class="glass-input" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-xs text-red-600"></span>
                <p class="text-xs text-slate-500 mt-1">At least 8 characters, one uppercase, one digit.</p>
            </div>

            <fieldset class="pt-2">
                <legend class="block text-sm text-slate-700 mb-2">I am a&hellip;</legend>
                <div class="grid grid-cols-2 gap-3">
                    <label class="glass-base p-4 flex flex-col items-start cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" asp-for="Input.Role" value="Renter" class="sr-only" />
                        <span class="font-semibold text-slate-900">Renter</span>
                        <span class="text-xs text-slate-500 mt-1">Looking for a place.</span>
                    </label>
                    <label class="glass-base p-4 flex flex-col items-start cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                        <input type="radio" asp-for="Input.Role" value="Landlord" class="sr-only" />
                        <span class="font-semibold text-slate-900">Landlord</span>
                        <span class="text-xs text-slate-500 mt-1">Posting properties.</span>
                    </label>
                </div>
                <span asp-validation-for="Input.Role" class="text-xs text-red-600"></span>
            </fieldset>

            <button type="submit" class="glass-button-primary w-full mt-2">Create account</button>
        </form>

        <p class="text-center text-sm text-slate-500 mt-6">
            Already have an account? <a href="/login" class="text-brand-600 font-medium hover:underline">Log in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
