@page "/{culture:locale}/signup"
@model Rent.Web.Features.Auth.Pages.SignupModel
@{
    ViewData["Title"] = L["auth.createAccount"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="glass-card p-8 sm:p-10">
    <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white text-center">@L["auth.createAccount"]</h1>
    <p class="text-slate-500 dark:text-white/60 text-center mt-2">@L["auth.signupQuick"]</p>

    <form method="post" class="mt-8 space-y-4">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm text-red-600 dark:text-red-400"></div>

        <div>
            <label asp-for="Input.FullName" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.fullName"]</label>
            <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="user" class="h-4 w-4" />
                </span>
                <input asp-for="Input.FullName" autocomplete="name" placeholder="@L["auth.fullNamePlaceholder"]" class="glass-input !pl-10" />
            </div>
            <span asp-validation-for="Input.FullName" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <label asp-for="Input.Email" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.email"]</label>
            <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="mail" class="h-4 w-4" />
                </span>
                <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="@L["auth.emailPlaceholder"]" class="glass-input !pl-10" />
            </div>
            <span asp-validation-for="Input.Email" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.password"]</label>
            <div class="relative" data-password-wrap>
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="lock" class="h-4 w-4" />
                </span>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="@L["auth.passwordPlaceholder"]" class="glass-input !pl-10 !pr-10" />
                <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                        data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                    <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                    <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                </button>
            </div>
            <span asp-validation-for="Input.Password" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            <p class="text-xs text-slate-500 dark:text-white/50 mt-1">@L["auth.passwordHint"]</p>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.confirmPassword"]</label>
            <div class="relative" data-password-wrap>
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40">
                    <icon name="lock" class="h-4 w-4" />
                </span>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="@L["auth.passwordPlaceholder"]" class="glass-input !pl-10 !pr-10" />
                <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                        data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                    <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                    <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </div>

        <fieldset class="pt-2">
            <legend class="block text-sm text-slate-700 dark:text-white/80 mb-2">@L["auth.iAmA"]</legend>
            <div class="grid grid-cols-2 gap-3">
                <label class="glass-base p-4 flex flex-col items-start cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:has-[:checked]:bg-brand-500/20 transition-colors">
                    <input type="radio" asp-for="Input.Role" value="Renter" class="sr-only" />
                    <icon name="home" class="h-5 w-5 text-brand-500 mb-2" />
                    <span class="font-semibold text-slate-900 dark:text-white">@L["auth.renterRole"]</span>
                    <span class="text-xs text-slate-500 dark:text-white/60 mt-1">@L["auth.renterCardLooking"]</span>
                </label>
                <label class="glass-base p-4 flex flex-col items-start cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:has-[:checked]:bg-brand-500/20 transition-colors">
                    <input type="radio" asp-for="Input.Role" value="Landlord" class="sr-only" />
                    <icon name="building" class="h-5 w-5 text-brand-500 mb-2" />
                    <span class="font-semibold text-slate-900 dark:text-white">@L["auth.landlordRole"]</span>
                    <span class="text-xs text-slate-500 dark:text-white/60 mt-1">@L["auth.landlordCardPosting"]</span>
                </label>
            </div>
            <span asp-validation-for="Input.Role" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
        </fieldset>

        <button type="submit" class="glass-button-primary w-full mt-2 inline-flex items-center justify-center gap-2">
            <icon name="user-plus" class="h-4 w-4" />
            @L["auth.signUpButton"]
        </button>
    </form>

    @if (Model.ExternalLogins.Any())
    {
        <div class="my-6 flex items-center gap-3 text-xs uppercase tracking-wider text-slate-400 dark:text-white/40">
            <span class="flex-1 h-px bg-slate-200 dark:bg-white/10"></span>
            <span>@L["auth.orContinueWith"]</span>
            <span class="flex-1 h-px bg-slate-200 dark:bg-white/10"></span>
        </div>

        <div class="space-y-2">
            @foreach (var scheme in Model.ExternalLogins)
            {
                <form method="post" asp-page-handler="ExternalLogin">
                    <input type="hidden" name="provider" value="@scheme.Name" />
                    <button type="submit" class="glass-button w-full inline-flex items-center justify-center gap-3" title="@L["auth.continueWithGoogle"]">
                        @if (scheme.Name == "Google")
                        {
                            <partial name="/Features/Auth/Pages/_GoogleIcon.cshtml" />
                        }
                        <span class="font-medium">@L["auth.continueWithGoogle"]</span>
                    </button>
                </form>
            }
        </div>
    }

    <p class="mt-6 text-center text-sm text-slate-600 dark:text-white/70">
        @L["auth.haveAccount"]
        <a href="/@culture/login" class="text-brand-600 dark:text-brand-400 font-medium hover:underline ml-1">@L["auth.signInLink"]</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
