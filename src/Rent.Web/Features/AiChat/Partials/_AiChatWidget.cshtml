@{
    var aiPropertyId = ViewContext.HttpContext.Items["AiCurrentPropertyId"] as string;
    var aiCurrentCity = ViewContext.HttpContext.Items["AiCurrentCity"] as string;
    var aiCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (aiCulture != "en" && aiCulture != "fr") { aiCulture = "en"; }
}
<div id="ai-chat-root"
     data-current-page="@ViewContext.HttpContext.Request.Path"
     data-current-city="@aiCurrentCity"
     data-current-property-id="@aiPropertyId"
     data-locale="@aiCulture">

    @* Paridad Next.js: FAB con gradiente translúcido + animate-glow + hover scale 110. *@
    <button type="button"
            id="ai-chat-trigger"
            class="fixed bottom-6 right-6 z-50 inline-flex items-center justify-center h-14 w-14 rounded-full bg-gradient-to-br from-brand-500/80 to-cyan-500/80 backdrop-blur-xl border border-white/20 shadow-xl shadow-brand-500/30 hover:shadow-2xl hover:shadow-brand-500/50 hover:scale-110 active:scale-95 transition-all duration-300 animate-glow focus:outline-none focus:ring-4 focus:ring-brand-500/40"
            aria-label="@L["aiChat.chatButton"]"
            aria-controls="ai-chat-panel">
        <icon name="sparkles" class="h-6 w-6 text-white" />
    </button>

    @* Paridad Next.js: panel glass-modal sin gradiente de fondo extra. *@
    <div id="ai-chat-panel"
         class="fixed z-50 hidden flex-col bottom-6 right-6 w-[400px] max-w-[calc(100vw-2rem)] h-[600px] max-h-[calc(100vh-2rem)] glass-modal overflow-hidden md:bottom-6 md:right-6 max-md:inset-3 max-md:w-auto max-md:h-auto max-md:bottom-3 max-md:right-3 max-md:top-3 max-md:left-3 max-md:max-h-none"
         role="dialog"
         aria-modal="false"
         aria-labelledby="ai-chat-title">

        @* Top highlight line *@
        <div class="glass-highlight"></div>

        @* Paridad Next.js: header simple, sin gradiente de fondo. Sparkles en cuadrado sutil. *@
        <header class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-white/10 shrink-0">
            <div class="flex items-center gap-2 min-w-0">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500/20 border border-brand-500/30 shrink-0">
                    <icon name="sparkles" class="h-4 w-4 text-brand-400" />
                </span>
                <div class="min-w-0">
                    <p id="ai-chat-title" class="text-sm font-semibold text-gray-900 dark:text-white leading-none truncate">@L["aiChat.title"]</p>
                    <p id="ai-chat-status" class="text-xs text-gray-500 dark:text-white/40 mt-0.5" data-online-text="@L["aiChat.online"]" data-thinking-text="@L["aiChat.thinking"]">@L["aiChat.online"]</p>
                </div>
            </div>

            <div class="flex items-center gap-1 shrink-0">
                @* Paridad Next.js: botón Clear como texto, solo visible cuando hay mensajes (JS toggles `hidden`). *@
                <button type="button" id="ai-chat-clear"
                        class="hidden text-xs text-gray-500 dark:text-white/40 hover:text-gray-700 dark:hover:text-white/70 px-2 py-1 rounded-lg hover:bg-gray-100 dark:hover:bg-white/5 transition-colors"
                        title="@L["aiChat.clearChat"]" aria-label="@L["aiChat.clearChat"]">
                    @L["aiChat.clearChat"]
                </button>
                <button type="button" id="ai-chat-close"
                        class="h-7 w-7 rounded-lg inline-flex items-center justify-center hover:bg-gray-100 dark:hover:bg-white/10 transition-colors"
                        title="@L["aiChat.close"]" aria-label="@L["aiChat.close"]">
                    <icon name="x" class="h-4 w-4 text-gray-500 dark:text-white/60" />
                </button>
            </div>
        </header>

        @* Messages area (visible cuando hay mensajes) *@
        <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-3 min-h-0" aria-live="polite" aria-atomic="false"></div>

        @* Paridad Next.js: empty state con avatar circular + emoji 🏠 + texto pequeño. *@
        <div id="ai-chat-empty" class="flex-1 flex flex-col items-center justify-center h-full text-center gap-3 pb-4 px-6">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-500/20 border border-brand-500/30">
                <span class="text-2xl" role="img" aria-hidden="true">&#x1F3E0;</span>
            </div>
            <div>
                <p class="text-gray-800 dark:text-white/80 text-sm font-medium">@L["aiChat.greeting"]</p>
                <p class="text-gray-500 dark:text-white/40 text-xs mt-1">@L["aiChat.greetingSub"]</p>
            </div>
        </div>

        @* Paridad Next.js: chips de sugerencias, solo visibles en empty state. *@
        <div id="ai-chat-suggestions" class="px-4 pb-3">
            <p class="text-xs text-gray-500 dark:text-white/40 mb-2">@L["aiChat.tryAsking"]</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" data-suggestion class="glass-badge text-xs text-gray-700 dark:text-white/70 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-white/15 transition-colors duration-200 cursor-pointer text-left">
                    @L["aiChat.suggestion1"]
                </button>
                <button type="button" data-suggestion class="glass-badge text-xs text-gray-700 dark:text-white/70 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-white/15 transition-colors duration-200 cursor-pointer text-left">
                    @L["aiChat.suggestion2"]
                </button>
                <button type="button" data-suggestion class="glass-badge text-xs text-gray-700 dark:text-white/70 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-white/15 transition-colors duration-200 cursor-pointer text-left">
                    @L["aiChat.suggestion3"]
                </button>
            </div>
        </div>

        @* Paridad Next.js: input area envuelta en glass-base con margen. Textarea transparente, botón cuadrado brand. *@
        <form id="ai-chat-form" class="glass-base mx-3 mb-3 flex items-end gap-2 p-2 rounded-2xl">
            <textarea id="ai-chat-input"
                      rows="1"
                      maxlength="2000"
                      placeholder="@L["aiChat.inputPlaceholder"]"
                      class="flex-1 resize-none bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-white/40 outline-none leading-relaxed py-1 px-1 max-h-24 overflow-y-auto disabled:opacity-50"
                      style="min-height:24px;"
                      aria-label="@L["detail.formMessage"]"></textarea>
            <button type="submit"
                    id="ai-chat-send"
                    class="h-8 w-8 rounded-xl inline-flex items-center justify-center shrink-0 bg-brand-500/30 hover:bg-brand-500/50 border border-brand-500/40 transition-all duration-200 hover:scale-105 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:scale-100"
                    aria-label="@L["aiChat.send"]">
                <icon name="send" class="h-4 w-4 text-brand-300" />
            </button>
        </form>
    </div>
</div>
