@{
    var aiPropertyId = ViewContext.HttpContext.Items["AiCurrentPropertyId"] as string;
    var aiCurrentCity = ViewContext.HttpContext.Items["AiCurrentCity"] as string;
    var aiCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (aiCulture != "en" && aiCulture != "fr") { aiCulture = "en"; }
}
<div id="ai-chat-root"
     data-current-page="@ViewContext.HttpContext.Request.Path"
     data-current-city="@aiCurrentCity"
     data-current-property-id="@aiPropertyId"
     data-locale="@aiCulture">

    <button type="button"
            id="ai-chat-trigger"
            class="fixed bottom-6 right-6 z-40 inline-flex items-center justify-center h-14 w-14 rounded-full text-white shadow-2xl transition-transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-brand-500/40"
            style="background: linear-gradient(135deg, #338dff 0%, #06b6d4 100%);"
            aria-label="@L["aiChat.chatButton"]"
            aria-controls="ai-chat-panel">
        <icon name="sparkles" class="h-6 w-6" />
    </button>

    <div id="ai-chat-panel"
         class="fixed z-50 hidden flex-col bottom-24 right-6 w-[400px] max-w-[calc(100vw-2rem)] h-[600px] max-h-[calc(100vh-7rem)] glass-modal border border-white/30 dark:border-white/15 rounded-2xl overflow-hidden md:bottom-24 md:right-6 max-md:inset-3 max-md:w-auto max-md:h-auto max-md:bottom-3 max-md:right-3 max-md:top-3 max-md:left-3 max-md:max-h-none"
         role="dialog"
         aria-modal="false"
         aria-labelledby="ai-chat-title">

        <header class="flex items-center justify-between gap-2 px-4 py-3 border-b border-white/20 dark:border-white/10"
                style="background: linear-gradient(135deg, rgba(51,141,255,0.12) 0%, rgba(6,182,212,0.12) 100%);">
            <div class="flex items-center gap-2 min-w-0">
                <span class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-white shrink-0"
                      style="background: linear-gradient(135deg, #338dff 0%, #06b6d4 100%);">
                    <icon name="sparkles" class="h-4 w-4" />
                </span>
                <div class="min-w-0">
                    <h3 id="ai-chat-title" class="text-sm font-semibold text-slate-900 dark:text-white truncate">@L["aiChat.title"]</h3>
                    <p id="ai-chat-status" class="text-xs text-slate-500 dark:text-white/60" data-online-text="@L["aiChat.online"]" data-thinking-text="@L["aiChat.thinking"]">@L["aiChat.online"]</p>
                </div>
            </div>
            <div class="flex items-center gap-1 shrink-0">
                <button type="button" id="ai-chat-clear"
                        class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-slate-600 dark:text-white/70 hover:bg-white/40 dark:hover:bg-white/10 transition-colors"
                        title="@L["aiChat.clearChat"]" aria-label="@L["aiChat.clearChat"]">
                    <icon name="trash-2" class="h-4 w-4" />
                </button>
                <button type="button" id="ai-chat-close"
                        class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-slate-600 dark:text-white/70 hover:bg-white/40 dark:hover:bg-white/10 transition-colors"
                        title="@L["aiChat.close"]" aria-label="@L["aiChat.close"]">
                    <icon name="x" class="h-4 w-4" />
                </button>
            </div>
        </header>

        <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3" aria-live="polite" aria-atomic="false"></div>

        <div id="ai-chat-empty" class="flex-1 flex flex-col items-center justify-center gap-4 px-6 py-6 text-center hidden">
            <span class="inline-flex items-center justify-center h-14 w-14 rounded-2xl text-white"
                  style="background: linear-gradient(135deg, #338dff 0%, #06b6d4 100%);">
                <icon name="sparkles" class="h-7 w-7" />
            </span>
            <h4 class="font-display text-lg text-slate-900 dark:text-white">@L["aiChat.greeting"]</h4>
            <p class="text-sm text-slate-500 dark:text-white/60">@L["aiChat.greetingSub"]</p>
            <div class="flex flex-col gap-2 w-full">
                <button type="button" data-suggestion class="text-left px-3 py-2 rounded-lg text-sm border border-white/30 dark:border-white/15 hover:bg-white/40 dark:hover:bg-white/10 transition-colors">
                    @L["aiChat.suggestion1"]
                </button>
                <button type="button" data-suggestion class="text-left px-3 py-2 rounded-lg text-sm border border-white/30 dark:border-white/15 hover:bg-white/40 dark:hover:bg-white/10 transition-colors">
                    @L["aiChat.suggestion2"]
                </button>
                <button type="button" data-suggestion class="text-left px-3 py-2 rounded-lg text-sm border border-white/30 dark:border-white/15 hover:bg-white/40 dark:hover:bg-white/10 transition-colors">
                    @L["aiChat.suggestion3"]
                </button>
            </div>
        </div>

        <form id="ai-chat-form" class="border-t border-white/20 dark:border-white/10 p-3 flex items-end gap-2 bg-white/40 dark:bg-slate-900/40">
            <textarea id="ai-chat-input"
                      rows="1"
                      maxlength="2000"
                      placeholder="@L["aiChat.inputPlaceholder"]"
                      class="flex-1 resize-none glass-input text-sm py-2 px-3 max-h-32"
                      aria-label="@L["detail.formMessage"]"></textarea>
            <button type="submit"
                    id="ai-chat-send"
                    class="inline-flex items-center justify-center h-10 w-10 rounded-xl text-white shrink-0 transition-transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
                    style="background: linear-gradient(135deg, #338dff 0%, #06b6d4 100%);"
                    aria-label="@L["aiChat.send"]">
                <icon name="send" class="h-4 w-4" />
            </button>
        </form>
    </div>
</div>
