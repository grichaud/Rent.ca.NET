@page "/renter/favorites"
@model Rent.Web.Features.Favorites.Pages.IndexModel
@{
    ViewData["Title"] = "My favorites";
    string BedsLabel(int n) => n == 0 ? "Studio" : $"{n}+";
    string BathsLabel(decimal n) => n <= 0m ? "—" : n == Math.Floor(n) ? n.ToString("0") : n.ToString("0.0");
}

<div class="space-y-6">
    <header>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">My Favorites</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">Properties you've saved for later.</p>
    </header>

    @if (Model.FlashSuccess is not null)
    {
        <div class="p-3 rounded-lg border border-emerald-300 bg-emerald-50 dark:border-emerald-500/40 dark:bg-emerald-500/10 text-sm text-emerald-700 dark:text-emerald-300 inline-flex items-center gap-2">
            <icon name="check-circle" class="h-4 w-4" />
            @Model.FlashSuccess
        </div>
    }

    @if (!Model.Favorites.Any())
    {
        <div class="glass-card p-10 text-center">
            <div class="inline-flex h-14 w-14 rounded-2xl bg-pink-500/20 items-center justify-center mb-4">
                <icon name="heart" class="h-7 w-7 text-pink-500 dark:text-pink-300" />
            </div>
            <h2 class="font-display text-2xl text-slate-900 dark:text-white">No favorites yet</h2>
            <p class="text-slate-500 dark:text-white/60 mt-2">Tap the heart on any listing to save it here.</p>
            <a href="/" class="glass-button-primary inline-flex items-center gap-2 mt-6">
                <icon name="search" class="h-4 w-4" />
                Browse listings
            </a>
        </div>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var fav in Model.Favorites)
            {
                <div class="group glass-card overflow-hidden flex flex-col p-0 hover:shadow-2xl hover:shadow-pink-500/10 transition-all duration-300">
                    <a href="/@fav.CitySlug/@fav.Slug" class="relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-brand-200 via-purple-200 to-cyan-200 dark:from-brand-900/40 dark:via-purple-900/40 dark:to-cyan-900/40 block">
                        @if (!string.IsNullOrEmpty(fav.PrimaryImageUrl))
                        {
                            <img src="@fav.PrimaryImageUrl" alt="@fav.Title" loading="lazy"
                                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="absolute inset-0 flex items-center justify-center text-white/80">
                                <icon name="building" class="h-16 w-16" />
                            </div>
                        }
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0 pointer-events-none"></div>
                        @if (fav.FromPrice.HasValue)
                        {
                            <div class="absolute bottom-3 left-3 text-white">
                                <div class="text-[10px] uppercase tracking-wider opacity-80">From</div>
                                <div class="font-display text-2xl leading-none">$@fav.FromPrice.Value.ToString("N0")<span class="text-xs opacity-80">/mo</span></div>
                            </div>
                        }
                    </a>

                    <div class="p-4 flex-1 flex flex-col">
                        <a href="/@fav.CitySlug/@fav.Slug" class="font-semibold text-slate-900 dark:text-white line-clamp-1 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">@fav.Title</a>
                        <div class="mt-1 text-xs text-slate-500 dark:text-white/60 inline-flex items-center gap-1">
                            <icon name="map-pin" class="h-3 w-3 shrink-0" />
                            <span class="truncate">@(fav.Neighbourhood ?? fav.City), @fav.City</span>
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-200 dark:border-white/10 flex items-center gap-4 text-xs text-slate-600 dark:text-white/70">
                            <span class="inline-flex items-center gap-1">
                                <icon name="bed" class="h-3.5 w-3.5" /> @BedsLabel(fav.MinBedrooms) bed
                            </span>
                            <span class="inline-flex items-center gap-1">
                                <icon name="bath" class="h-3.5 w-3.5" /> @BathsLabel(fav.MinBathrooms) bath
                            </span>
                            <span class="ml-auto inline-flex items-center gap-1 text-slate-500 dark:text-white/50">
                                <icon name="home" class="h-3.5 w-3.5" /> @fav.PropertyType
                            </span>
                        </div>

                        <form method="post" action="/renter/favorites/toggle?handler=Remove" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="propertyId" value="@fav.PropertyId" />
                            <button type="submit" class="glass-button w-full inline-flex items-center justify-center gap-2 text-sm text-rose-500 hover:text-rose-600 dark:text-rose-400 dark:hover:text-rose-300">
                                <icon name="trash-2" class="h-4 w-4" />
                                Remove
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
