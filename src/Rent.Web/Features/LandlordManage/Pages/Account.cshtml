@page "/{culture:locale}/landlord/account"
@model Rent.Web.Features.LandlordManage.Pages.AccountModel
@{
    ViewData["Title"] = L["landlord.accountTitle"].Value;
}

<div class="space-y-6 max-w-2xl">
    <header>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@L["landlord.accountTitle"]</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">@L["landlord.accountSubtitle"]</p>
    </header>

    @if (Model.FlashSuccess is not null)
    {
        <div role="status" class="p-3 rounded-lg border border-emerald-300 bg-emerald-50 dark:border-emerald-500/40 dark:bg-emerald-500/10 text-sm text-emerald-700 dark:text-emerald-300 inline-flex items-center gap-2">
            <icon name="check-circle" class="h-4 w-4" />
            @Model.FlashSuccess
        </div>
    }

    @if (Model.FlashError is not null)
    {
        <div role="alert" class="p-3 rounded-lg border border-red-300 bg-red-50 dark:border-red-500/40 dark:bg-red-500/10 text-sm text-red-700 dark:text-red-300 inline-flex items-center gap-2">
            <icon name="alert-circle" class="h-4 w-4" />
            @Model.FlashError
        </div>
    }

    <form method="post" asp-page-handler="Profile" class="space-y-6">
        <span asp-validation-for="Profile" role="alert" class="block text-sm text-red-600 dark:text-red-400"></span>

        <section class="glass-card p-6 space-y-3">
            <h2 class="font-semibold text-slate-900 dark:text-white mb-1">@L["renter.accountProfile"]</h2>
            <p class="text-sm text-slate-500 dark:text-white/60 mb-4">@L["renter.accountEmail"] <span class="text-slate-700 dark:text-white/80">@Model.Email</span></p>

            <div>
                <label asp-for="Profile.FullName" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@L["auth.fullName"]</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                        <icon name="user" class="h-4 w-4" />
                    </span>
                    <input asp-for="Profile.FullName" class="glass-input !pl-10" autocomplete="name" placeholder="@L["auth.fullNamePlaceholder"]" />
                </div>
                <span asp-validation-for="Profile.FullName" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label asp-for="Profile.Phone" class="block text-sm text-slate-700 dark:text-white/80 mb-1">
                    @L["renter.accountPhone"] <span class="text-slate-400 dark:text-white/40 font-normal">@L["renter.accountPhoneOptional"]</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                        <icon name="phone" class="h-4 w-4" />
                    </span>
                    <input asp-for="Profile.Phone" type="tel" class="glass-input !pl-10" autocomplete="tel" placeholder="@L["renter.accountPhonePlaceholder"]" />
                </div>
                <span asp-validation-for="Profile.Phone" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>
        </section>

        <section class="glass-card p-6 space-y-3">
            <div class="flex items-center gap-2 mb-1">
                <h2 class="font-semibold text-slate-900 dark:text-white">@L["landlord.accountBrand"]</h2>
                @if (Model.IsVerified)
                {
                    <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-700 dark:text-emerald-300">
                        <icon name="shield-check" class="h-3 w-3" />
                        @L["detail.verified"]
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 dark:text-white/60 mb-4">@L["landlord.accountBrandHint"]</p>

            <div>
                <label asp-for="Profile.CompanyName" class="block text-sm text-slate-700 dark:text-white/80 mb-1">
                    @L["landlord.accountCompany"] <span class="text-slate-400 dark:text-white/40 font-normal">@L["landlord.formOptional"]</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                        <icon name="building" class="h-4 w-4" />
                    </span>
                    <input asp-for="Profile.CompanyName" class="glass-input !pl-10" placeholder="@L["landlord.accountCompanyPlaceholder"]" />
                </div>
                <span asp-validation-for="Profile.CompanyName" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label asp-for="Profile.Website" class="block text-sm text-slate-700 dark:text-white/80 mb-1">
                    @L["landlord.accountWebsite"] <span class="text-slate-400 dark:text-white/40 font-normal">@L["landlord.formOptional"]</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                        <icon name="external-link" class="h-4 w-4" />
                    </span>
                    <input asp-for="Profile.Website" type="url" class="glass-input !pl-10" placeholder="https://example.com" />
                </div>
                <span asp-validation-for="Profile.Website" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label asp-for="Profile.Description" class="block text-sm text-slate-700 dark:text-white/80 mb-1">
                    @L["landlord.accountBio"] <span class="text-slate-400 dark:text-white/40 font-normal">@L["landlord.formOptional"]</span>
                </label>
                <textarea asp-for="Profile.Description" rows="4" class="glass-input" placeholder="@L["landlord.accountBioPlaceholder"]"></textarea>
                <span asp-validation-for="Profile.Description" role="alert" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <button type="submit" class="glass-button-primary inline-flex items-center gap-2">
                <icon name="check" class="h-4 w-4" />
                @L["renter.accountSaveProfile"]
            </button>
        </section>
    </form>

    <section class="glass-card p-6">
        <h2 class="font-semibold text-slate-900 dark:text-white mb-1">@L["renter.accountPassword"]</h2>

        @if (!Model.HasPassword)
        {
            <div class="mt-3 p-3 rounded-lg border border-blue-200 bg-blue-50 dark:border-blue-500/40 dark:bg-blue-500/10 text-sm text-blue-700 dark:text-blue-300 inline-flex items-center gap-2">
                <icon name="info" class="h-4 w-4" />
                @L["renter.accountGoogleNote"]
            </div>
        }
        else
        {
            <p class="text-sm text-slate-500 dark:text-white/60 mb-4">@L["renter.accountPasswordHint"]</p>

            <form method="post" asp-page-handler="Password" class="space-y-3">
                <span asp-validation-for="Password" role="alert" class="block text-sm text-red-600 dark:text-red-400"></span>

                @foreach (var f in new[]
                {
                    (Name: "Password.CurrentPassword", Label: L["renter.accountCurrentPassword"].Value, Auto: "current-password"),
                    (Name: "Password.NewPassword", Label: L["renter.accountNewPassword"].Value, Auto: "new-password"),
                    (Name: "Password.ConfirmPassword", Label: L["renter.accountConfirmPassword"].Value, Auto: "new-password")
                })
                {
                    <div>
                        <label for="@f.Name.Replace(".", "_")" class="block text-sm text-slate-700 dark:text-white/80 mb-1">@f.Label</label>
                        <div class="relative" data-password-wrap>
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 z-10 text-slate-400 dark:text-white/40">
                                <icon name="lock" class="h-4 w-4" />
                            </span>
                            <input id="@f.Name.Replace(".", "_")" name="@f.Name" type="password" class="glass-input !pl-10 !pr-10"
                                   autocomplete="@f.Auto" placeholder="@L["auth.passwordPlaceholder"]" />
                            <button type="button" data-password-toggle aria-label="@L["auth.showPassword"]"
                                    data-show-label="@L["auth.showPassword"]" data-hide-label="@L["auth.hidePassword"]"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-white/40 hover:text-slate-700 dark:hover:text-white/80">
                                <span data-pw-icon="show"><icon name="eye" class="h-4 w-4" /></span>
                                <span data-pw-icon="hide" class="hidden"><icon name="eye-off" class="h-4 w-4" /></span>
                            </button>
                        </div>
                        @if (f.Name == "Password.NewPassword")
                        {
                            <p class="text-xs text-slate-500 dark:text-white/50 mt-1">@L["auth.passwordHint"]</p>
                        }
                    </div>
                }

                <button type="submit" class="glass-button-primary inline-flex items-center gap-2">
                    <icon name="lock" class="h-4 w-4" />
                    @L["renter.accountChangePassword"]
                </button>
            </form>
        }
    </section>
</div>
