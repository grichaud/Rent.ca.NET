@page "/{culture:locale}/landlord/inbox"
@model Rent.Web.Features.LandlordManage.Pages.InboxModel
@{
    ViewData["Title"] = "Inbox";
}

<section class="flex items-end justify-between mb-6">
    <div>
        <h1 class="font-display text-3xl text-slate-900 dark:text-white">Inbox</h1>
        <p class="text-slate-600 dark:text-white/70 mt-1">@Model.TotalCount inquir@(Model.TotalCount == 1 ? "y" : "ies") &middot; @Model.UnreadCount unread.</p>
    </div>
    <div class="flex gap-2 text-sm">
        <a href="/landlord/inbox" class="glass-button text-slate-700 dark:text-white/80 @(Model.Filter == "all" ? "!bg-brand-500 !text-white" : "")">All</a>
        <a href="/landlord/inbox?filter=unread" class="glass-button text-slate-700 dark:text-white/80 @(Model.Filter == "unread" ? "!bg-brand-500 !text-white" : "")">Unread</a>
    </div>
</section>

@if (TempData["InquiryAction"] as string is string msg)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl p-3 mb-6">@msg</div>
}

@if (Model.Inquiries.Count == 0)
{
    <div class="glass-card p-10 text-center">
        <p class="text-slate-600 dark:text-white/70">No inquiries @(Model.Filter == "unread" ? "unread" : "yet").</p>
    </div>
}
else
{
    <div class="space-y-3">
        @foreach (var i in Model.Inquiries)
        {
            <article class="glass-card p-5 @(!i.IsRead ? "border-l-4 border-l-brand-500" : "")">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-semibold text-slate-900 dark:text-white">@i.SenderName</span>
                            <a href="mailto:@i.SenderEmail" class="text-sm text-brand-600 hover:underline">@i.SenderEmail</a>
                            @if (!string.IsNullOrEmpty(i.SenderPhone))
                            {
                                <span class="text-sm text-slate-500 dark:text-white/50">&middot; @i.SenderPhone</span>
                            }
                            @if (!i.IsRead)
                            {
                                <span class="text-[10px] uppercase font-semibold bg-brand-50 text-brand-700 border border-brand-200 px-1.5 py-0.5 rounded">New</span>
                            }
                        </div>
                        <div class="text-xs text-slate-500 dark:text-white/50 mt-1">
                            @i.CreatedAt.ToString("MMM d, yyyy h:mm tt") &middot; re: <a href="/@i.CitySlug/@i.PropertySlug" class="hover:underline">@i.PropertyTitle</a>
                            @if (i.MoveInDate.HasValue)
                            {
                                <span class="ml-2">move-in @i.MoveInDate.Value.ToString("MMM d, yyyy")</span>
                            }
                        </div>
                        <p class="text-slate-700 dark:text-white/80 mt-3 whitespace-pre-line">@i.Message</p>
                    </div>
                    <form method="post" action="/landlord/inbox?handler=Toggle" class="flex-shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="inquiryId" value="@i.Id" />
                        <input type="hidden" name="filter" value="@Model.Filter" />
                        <button type="submit" class="glass-button text-slate-700 dark:text-white/80 text-xs whitespace-nowrap">
                            @(i.IsRead ? "Mark unread" : "Mark read")
                        </button>
                    </form>
                </div>
            </article>
        }
    </div>
}
