@page "/{culture:locale}/landlord/listings/create"
@model Rent.Web.Features.LandlordManage.Pages.Listings.CreateModel
@{
    ViewData["Title"] = "New listing";
}

<section class="max-w-3xl mx-auto">
    <a href="/landlord/listings" class="text-sm text-slate-500 dark:text-white/50 hover:underline">&larr; Back to listings</a>
    <h1 class="font-display text-3xl text-slate-900 dark:text-white mt-2">New listing</h1>

    <form method="post" enctype="multipart/form-data" class="mt-6 space-y-6">
        <div asp-validation-summary="All" class="text-sm text-red-600 dark:text-red-400"></div>

        <section class="glass-card p-6 space-y-4">
            <h2 class="font-semibold text-slate-900 dark:text-white">Basics</h2>
            <div>
                <label asp-for="Input.Title" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Title</label>
                <input asp-for="Input.Title" class="glass-input" placeholder="Bright 2BR in downtown Toronto" />
            </div>
            <div>
                <label asp-for="Input.Description" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Description</label>
                <textarea asp-for="Input.Description" rows="5" class="glass-input"></textarea>
            </div>
            <div>
                <label asp-for="Input.PropertyType" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Property type</label>
                <select asp-for="Input.PropertyType" class="glass-input">
                    @foreach (var t in Enum.GetValues<Rent.Web.Domain.PropertyType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
        </section>

        <section class="glass-card p-6 space-y-4">
            <h2 class="font-semibold text-slate-900 dark:text-white">Location</h2>
            <div>
                <label asp-for="Input.StreetAddress" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Street address</label>
                <input asp-for="Input.StreetAddress" class="glass-input" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.CityName" class="block text-sm text-slate-700 dark:text-white/80 mb-1">City</label>
                    <input asp-for="Input.CityName" class="glass-input" placeholder="Toronto" />
                </div>
                <div>
                    <label asp-for="Input.Province" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Province</label>
                    <input asp-for="Input.Province" class="glass-input" placeholder="ON" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.PostalCode" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Postal code</label>
                    <input asp-for="Input.PostalCode" class="glass-input" />
                </div>
                <div>
                    <label asp-for="Input.Neighbourhood" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Neighbourhood (optional)</label>
                    <input asp-for="Input.Neighbourhood" class="glass-input" />
                </div>
            </div>
        </section>

        <section class="glass-card p-6 space-y-4">
            <h2 class="font-semibold text-slate-900 dark:text-white">Unit details</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label asp-for="Input.Bedrooms" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Bedrooms</label>
                    <input asp-for="Input.Bedrooms" type="number" min="0" max="20" class="glass-input" />
                </div>
                <div>
                    <label asp-for="Input.Bathrooms" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Bathrooms</label>
                    <input asp-for="Input.Bathrooms" type="number" step="0.5" min="0.5" class="glass-input" />
                </div>
                <div>
                    <label asp-for="Input.SqFt" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Sq ft</label>
                    <input asp-for="Input.SqFt" type="number" min="0" class="glass-input" />
                </div>
                <div>
                    <label asp-for="Input.Price" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Monthly price (CAD)</label>
                    <input asp-for="Input.Price" type="number" step="50" min="0" class="glass-input" />
                </div>
            </div>
            <div>
                <label asp-for="Input.AvailableDate" class="block text-sm text-slate-700 dark:text-white/80 mb-1">Available from</label>
                <input asp-for="Input.AvailableDate" type="date" class="glass-input" />
            </div>
            <div class="flex gap-6">
                <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-white/80">
                    <input asp-for="Input.PetsAllowed" type="checkbox" class="rounded border-gray-300 dark:border-white/20" />
                    Pet friendly
                </label>
                <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-white/80">
                    <input asp-for="Input.Furnished" type="checkbox" class="rounded border-gray-300 dark:border-white/20" />
                    Furnished
                </label>
            </div>
        </section>

        <section class="glass-card p-6 space-y-3">
            <h2 class="font-semibold text-slate-900 dark:text-white">Photos</h2>
            <p class="text-xs text-slate-500 dark:text-white/50">Upload up to 10 photos (JPG, PNG, WebP). The first photo becomes the cover.</p>
            <input type="file" name="Input.NewImages" multiple accept="image/*"
                   class="block w-full text-sm text-slate-700 dark:text-white/80 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-brand-500 file:text-white file:font-medium hover:file:bg-brand-600" />
        </section>

        <div class="flex gap-3 justify-end">
            <a href="/landlord/listings" class="glass-button">Cancel</a>
            <button type="submit" class="glass-button-primary">Create listing</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
