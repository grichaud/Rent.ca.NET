@page "/{culture:locale}/landlord"
@model Rent.Web.Features.LandlordManage.Pages.DashboardModel
@{
    ViewData["Title"] = L["landlord.dashboardTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
            @(Model.FirstName is null ? L["landlord.dashboardTitle"].Value : string.Format(L["landlord.dashboardWelcome"].Value, Model.FirstName)) 👋
        </h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">@L["landlord.dashboardSubtitle"]</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <a href="/@culture/landlord/listings" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-brand-500/20">
                <icon name="building" class="h-6 w-6 text-brand-500 dark:text-brand-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["landlord.totalListings"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalListings</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>

        <div class="glass-card p-5 flex items-center gap-4">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-purple-500/20">
                <icon name="eye" class="h-6 w-6 text-purple-500 dark:text-purple-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["landlord.totalViews"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalViews.ToString("N0")</p>
            </div>
        </div>

        <a href="/@culture/landlord/inbox" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-cyan-500/20">
                <icon name="message-square" class="h-6 w-6 text-cyan-500 dark:text-cyan-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["landlord.totalLeads"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalInquiries</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>

        <a href="/@culture/landlord/inbox?filter=unread" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-amber-500/20">
                <icon name="bell" class="h-6 w-6 text-amber-500 dark:text-amber-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["landlord.unreadLeads"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.UnreadInquiries</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>
    </div>

    <div>
        <h2 class="text-sm font-medium mb-3 text-slate-500 dark:text-white/50">@L["landlord.recentInquiries"]</h2>
        @if (Model.Recent.Count == 0)
        {
            <div class="glass-card p-6 text-center text-sm text-slate-500 dark:text-white/60">@L["landlord.noRecentInquiries"]</div>
        }
        else
        {
            <div class="glass-card divide-y divide-gray-200 dark:divide-white/10 p-0 overflow-hidden">
                @foreach (var inq in Model.Recent)
                {
                    <a href="/@culture/landlord/inbox" class="flex items-center gap-3 p-4 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                        <div class="h-9 w-9 rounded-xl bg-cyan-500/15 flex items-center justify-center shrink-0">
                            <icon name="message-square" class="h-4 w-4 text-cyan-500 dark:text-cyan-300" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate">@inq.SenderName</p>
                            <p class="text-xs text-slate-500 dark:text-white/50 truncate">@inq.PropertyTitle</p>
                        </div>
                        @if (!inq.IsRead)
                        {
                            <span class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-md bg-brand-500/20 text-brand-700 dark:text-brand-300 shrink-0">@L["landlord.inboxNew"]</span>
                        }
                        <span class="text-xs text-slate-400 dark:text-white/40 shrink-0 hidden sm:block">@Rent.Web.Features.Shared.DateFormat.Long(inq.CreatedAt)</span>
                    </a>
                }
            </div>
        }
    </div>

    <div>
        <h2 class="text-sm font-medium mb-3 text-slate-500 dark:text-white/50">@L["landlord.quickActions"]</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/@culture/landlord/listings/create" class="glass-card p-4 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
                <div class="h-10 w-10 rounded-xl bg-brand-500/20 flex items-center justify-center shrink-0">
                    <icon name="plus" class="h-5 w-5 text-brand-500 dark:text-brand-300" />
                </div>
                <div>
                    <p class="text-gray-900 dark:text-white font-medium text-sm">@L["landlord.addListing"]</p>
                    <p class="text-xs text-slate-500 dark:text-white/50">@L["landlord.addListingDesc"]</p>
                </div>
                <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 ml-auto transition-colors" />
            </a>

            <a href="/@culture/landlord/inbox" class="glass-card p-4 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
                <div class="h-10 w-10 rounded-xl bg-gray-100 dark:bg-white/10 flex items-center justify-center shrink-0">
                    <icon name="mail" class="h-5 w-5 text-gray-400 dark:text-white/60" />
                </div>
                <div>
                    <p class="text-gray-900 dark:text-white font-medium text-sm">@L["landlord.viewInbox"]</p>
                    <p class="text-xs text-slate-500 dark:text-white/50">@L["landlord.viewInboxDesc"]</p>
                </div>
                <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 ml-auto transition-colors" />
            </a>
        </div>
    </div>
</div>
