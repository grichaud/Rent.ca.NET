@page "/landlord"
@model Rent.Web.Features.LandlordManage.Pages.DashboardModel
@{
    ViewData["Title"] = "Landlord dashboard";
}

<section class="max-w-3xl mx-auto glass-card p-10">
    <h1 class="font-display text-3xl text-slate-900">Welcome, @Model.FullName.</h1>
    <p class="text-slate-600 mt-2">Your landlord portal.</p>

    <div class="mt-8 grid sm:grid-cols-2 gap-4">
        <a href="/landlord/listings" class="glass-base p-5 hover:scale-[1.01] transition-transform">
            <div class="font-semibold text-slate-900">My listings</div>
            <div class="text-sm text-slate-500 mt-1">Create, edit, and manage your properties. (slice 4)</div>
        </a>
        <a href="/landlord/inbox" class="glass-base p-5 hover:scale-[1.01] transition-transform">
            <div class="font-semibold text-slate-900">Inbox</div>
            <div class="text-sm text-slate-500 mt-1">Inquiries from prospective renters. (slice 5)</div>
        </a>
    </div>
</section>
