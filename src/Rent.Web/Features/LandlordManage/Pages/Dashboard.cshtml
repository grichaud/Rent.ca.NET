@page "/{culture:locale}/landlord"
@model Rent.Web.Features.LandlordManage.Pages.DashboardModel
@{
    ViewData["Title"] = "Landlord dashboard";
}

<section class="max-w-3xl mx-auto glass-card p-10">
    <div class="flex items-center gap-4 mb-2">
        <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
            <icon name="user" class="h-6 w-6" />
        </div>
        <div>
            <h1 class="font-display text-3xl text-slate-900 dark:text-white">Welcome, @Model.FullName.</h1>
            <p class="text-slate-600 dark:text-white/70 text-sm">Your landlord portal.</p>
        </div>
    </div>

    <div class="mt-8 grid sm:grid-cols-2 gap-4">
        <a href="/landlord/listings" class="glass-base p-5 hover:scale-[1.02] hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300 group">
            <icon name="home" class="h-6 w-6 text-brand-500 mb-2 group-hover:scale-110 transition-transform" />
            <div class="font-semibold text-slate-900 dark:text-white">My listings</div>
            <div class="text-sm text-slate-500 dark:text-white/60 mt-1">Create, edit, and manage your properties.</div>
        </a>
        <a href="/landlord/inbox" class="glass-base p-5 hover:scale-[1.02] hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300 group">
            <icon name="mail" class="h-6 w-6 text-brand-500 mb-2 group-hover:scale-110 transition-transform" />
            <div class="font-semibold text-slate-900 dark:text-white">Inbox</div>
            <div class="text-sm text-slate-500 dark:text-white/60 mt-1">Inquiries from prospective renters.</div>
        </a>
    </div>
</section>
