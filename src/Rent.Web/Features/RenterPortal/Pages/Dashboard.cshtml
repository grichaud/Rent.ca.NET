@page "/{culture:locale}/renter"
@model Rent.Web.Features.RenterPortal.Pages.DashboardModel
@{
    ViewData["Title"] = L["renter.dashboardTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
}

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@(Model.FirstName is null ? L["renter.dashboardWelcomeNoName"].Value : string.Format(L["renter.dashboardWelcome"].Value, Model.FirstName)) 👋</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">@L["renter.dashboardSubtitle"]</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/@culture/renter/favorites" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-pink-500/20">
                <icon name="heart" class="h-6 w-6 text-pink-500 dark:text-pink-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["renter.savedProperties"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.SavedProperties</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>

        <a href="/@culture/renter/alerts" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-brand-500/20">
                <icon name="bell" class="h-6 w-6 text-brand-500 dark:text-brand-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["renter.activeAlerts"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.ActiveAlerts</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>

        <a href="/@culture/renter/inquiries" class="glass-card p-5 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl shrink-0 bg-cyan-500/20">
                <icon name="message-square" class="h-6 w-6 text-cyan-500 dark:text-cyan-300" />
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-500 dark:text-white/50">@L["renter.inquiriesSent"]</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.InquiriesSent</p>
            </div>
            <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 transition-colors shrink-0" />
        </a>
    </div>

    <div>
        <h2 class="text-sm font-medium mb-3 text-slate-500 dark:text-white/50">@L["renter.quickActions"]</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="/@culture" class="glass-card p-4 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
                <div class="h-10 w-10 rounded-xl bg-gray-100 dark:bg-white/10 flex items-center justify-center shrink-0">
                    <icon name="search" class="h-5 w-5 text-gray-400 dark:text-white/60" />
                </div>
                <div>
                    <p class="text-gray-900 dark:text-white font-medium text-sm">@L["renter.browseListings"]</p>
                    <p class="text-xs text-slate-500 dark:text-white/50">@L["renter.findYourNextHome"]</p>
                </div>
                <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 ml-auto transition-colors" />
            </a>

            <a href="/@culture/renter/alerts" class="glass-card p-4 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-white/10 transition-colors group">
                <div class="h-10 w-10 rounded-xl bg-brand-500/20 flex items-center justify-center shrink-0">
                    <icon name="bell" class="h-5 w-5 text-brand-500 dark:text-brand-300" />
                </div>
                <div>
                    <p class="text-gray-900 dark:text-white font-medium text-sm">@L["detail.setAlert"]</p>
                    <p class="text-xs text-slate-500 dark:text-white/50">@L["renter.getNotifiedNew"]</p>
                </div>
                <icon name="arrow-right" class="h-4 w-4 text-gray-300 dark:text-white/30 group-hover:text-gray-500 dark:group-hover:text-white/60 ml-auto transition-colors" />
            </a>
        </div>
    </div>
</div>
