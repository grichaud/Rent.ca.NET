@{
    Layout = "_Layout";
}

@section Scripts {
    <script src="~/js/renter-sidebar.js" asp-append-version="true" defer></script>
}

<div class="-mt-8 sm:-mt-12 -mx-4 sm:-mx-6 grid lg:grid-cols-[16rem_1fr] min-h-[calc(100vh-4rem)]">
    <aside class="hidden lg:block sticky top-16 self-start h-[calc(100vh-4rem)] border-r border-gray-200 dark:border-white/10 bg-white/40 dark:bg-slate-950/40 backdrop-blur-xl">
        <partial name="/Features/RenterPortal/Partials/_RenterSidebar.cshtml" />
    </aside>

    <div class="flex flex-col">
        <div class="lg:hidden flex items-center justify-between px-4 sm:px-6 py-3 border-b border-gray-200 dark:border-white/10 bg-white/40 dark:bg-slate-950/40 backdrop-blur-xl">
            <button type="button" data-renter-sidebar-open
                    class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white"
                    aria-label="@L["common.myPortal"]" aria-controls="renter-sidebar-drawer" aria-expanded="false">
                <icon name="menu" class="h-5 w-5" />
                <span class="font-medium">@L["common.myPortal"]</span>
            </button>
            <span class="text-xs text-slate-500 dark:text-white/50">@L["renter.role"]</span>
        </div>

        <main class="flex-1 px-4 sm:px-6 py-6 sm:py-8">
            @RenderBody()
        </main>
    </div>
</div>

<div id="renter-sidebar-drawer" class="lg:hidden fixed inset-0 z-50 pointer-events-none" aria-hidden="true">
    <div data-renter-sidebar-overlay class="absolute inset-0 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <aside class="absolute top-0 left-0 bottom-0 w-72 max-w-[85vw] bg-white/95 dark:bg-slate-950/95 backdrop-blur-2xl border-r border-gray-200 dark:border-white/10 shadow-2xl -translate-x-full transition-transform duration-300 ease-out flex flex-col" data-renter-sidebar-panel>
        <div class="flex items-center justify-end p-3 border-b border-gray-200 dark:border-white/10">
            <button type="button" data-renter-sidebar-close
                    class="inline-flex items-center justify-center h-9 w-9 rounded-lg text-slate-600 dark:text-white/70 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors"
                    aria-label="@L["navbar.close"]">
                <icon name="x" class="h-5 w-5" />
            </button>
        </div>
        <div class="flex-1 overflow-y-auto">
            <partial name="/Features/RenterPortal/Partials/_RenterSidebar.cshtml" />
        </div>
    </aside>
</div>
