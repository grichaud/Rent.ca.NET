@page "/{culture:locale}/admin/properties"
@model Rent.Web.Features.Admin.Pages.PropertiesModel
@using Rent.Web.Domain
@{
    ViewData["Title"] = L["admin.propertiesTitle"].Value;
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@L["admin.propertiesTitle"]</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">@L["admin.propertiesSubtitle"]</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.FlashSuccess))
    {
        <div class="glass-card p-3 text-sm text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">@Model.FlashSuccess</div>
    }
    @if (!string.IsNullOrEmpty(Model.FlashError))
    {
        <div class="glass-card p-3 text-sm text-rose-700 dark:text-rose-300 border border-rose-500/30">@Model.FlashError</div>
    }

    <form method="get" class="glass-card p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="text" name="City" value="@Model.City" placeholder="@L["admin.filterCity"]" class="glass-input text-sm" />
        <select name="Tier" class="glass-input text-sm">
            <option value="">@L["admin.filterAnyTier"]</option>
            @foreach (var t in Enum.GetValues<ListingTier>())
            {
                <option value="@t" selected="@(Model.Tier == t)">@t</option>
            }
        </select>
        <select name="Status" class="glass-input text-sm">
            <option value="">@L["admin.filterAnyStatus"]</option>
            @foreach (var s in Enum.GetValues<ListingStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
        <input type="text" name="Landlord" value="@Model.Landlord" placeholder="@L["admin.filterLandlordEmail"]" class="glass-input text-sm" />
        <button type="submit" class="glass-button-primary text-sm">@L["admin.applyFilters"]</button>
    </form>

    <div class="text-xs text-slate-500 dark:text-white/50">
        @string.Format(L["admin.resultsCount"].Value, Model.TotalRows)
    </div>

    <div class="overflow-x-auto glass-card">
        <table class="min-w-full text-sm">
            <thead class="text-left text-xs uppercase tracking-wider text-slate-500 dark:text-white/50">
                <tr>
                    <th class="px-4 py-3">@L["admin.colTitle"]</th>
                    <th class="px-4 py-3">@L["admin.colCity"]</th>
                    <th class="px-4 py-3">@L["admin.colLandlord"]</th>
                    <th class="px-4 py-3">@L["admin.colStatus"]</th>
                    <th class="px-4 py-3">@L["admin.colTier"]</th>
                    <th class="px-4 py-3">@L["admin.colExpires"]</th>
                    <th class="px-4 py-3">@L["admin.colActions"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">@row.Title</td>
                        <td class="px-4 py-3 text-slate-600 dark:text-white/70">@row.CityName</td>
                        <td class="px-4 py-3 text-slate-600 dark:text-white/70 truncate max-w-[180px]" title="@row.LandlordEmail">@row.LandlordEmail</td>
                        <td class="px-4 py-3"><span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-white/80">@row.Status</span></td>
                        <td class="px-4 py-3">
                            @if (row.EffectiveTier == ListingTier.Featured)
                            {
                                <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-bold bg-gradient-to-r from-amber-400 to-orange-500 text-white">FEATURED</span>
                            }
                            else if (row.EffectiveTier == ListingTier.Promoted)
                            {
                                <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-bold bg-gradient-to-r from-brand-500 to-cyan-500 text-white">PROMOTED</span>
                            }
                            else
                            {
                                <span class="inline-flex rounded-md px-2 py-0.5 text-xs text-slate-500 dark:text-white/60">Limited</span>
                            }
                            @if (row.Tier != row.EffectiveTier)
                            {
                                <span class="ml-1 text-[10px] text-rose-500" title="@L["admin.expiredTooltip"]">(@row.Tier expired)</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-xs text-slate-500 dark:text-white/60">
                            @(row.TierExpiresAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                        </td>
                        <td class="px-4 py-3">
                            <form method="post" asp-page-handler="SetTier" class="flex flex-wrap items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TargetId" value="@row.Id" />
                                <select name="Tier" class="glass-input text-xs py-1 px-2">
                                    @foreach (var t in Enum.GetValues<ListingTier>())
                                    {
                                        <option value="@t" selected="@(row.Tier == t)">@t</option>
                                    }
                                </select>
                                <input type="datetime-local" name="ExpiresAt" class="glass-input text-xs py-1 px-2"
                                       value="@(row.TierExpiresAt?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty)" />
                                <button type="submit" class="glass-button text-xs py-1 px-2">@L["admin.applyAction"]</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="px-4 py-8 text-center text-sm text-slate-500 dark:text-white/50">@L["admin.noResults"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 text-sm">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a href="?City=@Model.City&Tier=@Model.Tier&Status=@Model.Status&Landlord=@Model.Landlord&Page=@p"
                   class="px-3 py-1 rounded-md @(p == Model.PageIndex ? "bg-amber-500/20 text-amber-600 dark:text-amber-300" : "text-slate-500 dark:text-white/60 hover:bg-gray-100 dark:hover:bg-white/10")">@p</a>
            }
        </div>
    }
</div>
