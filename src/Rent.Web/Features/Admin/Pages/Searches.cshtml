@page "/{culture:locale}/admin/searches"
@model Rent.Web.Features.Admin.Pages.SearchesModel
@{
    ViewData["Title"] = L["admin.searchesTitle"].Value;
    var editing = Model.EditingRow;
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">@L["admin.searchesTitle"]</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-white/70">@L["admin.searchesSubtitle"]</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.FlashSuccess))
    {
        <div class="glass-card p-3 text-sm text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">@Model.FlashSuccess</div>
    }
    @if (!string.IsNullOrEmpty(Model.FlashError))
    {
        <div class="glass-card p-3 text-sm text-rose-700 dark:text-rose-300 border border-rose-500/30">@Model.FlashError</div>
    }

    <form method="get" class="glass-card p-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <input type="text" name="q" value="@Model.FilterQuery" placeholder="@L["admin.searchesFilterPlaceholder"]" class="glass-input text-sm" />
        <button type="submit" class="glass-button-primary text-sm">@L["admin.applyFilters"]</button>
    </form>

    @if (editing is not null)
    {
        <form method="post" asp-page-handler="Update" class="glass-card p-5 space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@editing.Id" />
            <div class="text-base font-semibold text-gray-900 dark:text-white">@L["admin.searchesEditTitle"]</div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-slate-500 dark:text-white/50 mb-1">@L["admin.searchesColQuery"]</label>
                    <input type="text" name="NormalizedQuery" value="@editing.NormalizedQuery" maxlength="200" required class="glass-input text-sm w-full" />
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-slate-500 dark:text-white/50 mb-1">@L["admin.searchesColCity"]</label>
                    <input type="text" name="CitySlug" value="@editing.CitySlug" maxlength="100" class="glass-input text-sm w-full" />
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="glass-button-primary text-sm">@L["admin.specialsSave"]</button>
                <a href="/en/admin/searches" class="glass-button text-sm">@L["common.cancel"]</a>
            </div>
        </form>
    }

    <div class="overflow-x-auto glass-card">
        <table class="min-w-full text-sm">
            <thead class="text-left text-xs uppercase tracking-wider text-slate-500 dark:text-white/50">
                <tr>
                    <th class="px-4 py-3">@L["admin.searchesColQuery"]</th>
                    <th class="px-4 py-3">@L["admin.searchesColCity"]</th>
                    <th class="px-4 py-3">@L["admin.searchesColCount"]</th>
                    <th class="px-4 py-3">@L["admin.searchesColLastSeen"]</th>
                    <th class="px-4 py-3">@L["admin.colActions"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-white/5">
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="px-4 py-3 font-mono text-xs text-gray-900 dark:text-white truncate max-w-[400px]" title="@r.NormalizedQuery">@r.NormalizedQuery</td>
                        <td class="px-4 py-3 text-slate-600 dark:text-white/70">@(string.IsNullOrEmpty(r.CitySlug) ? "—" : r.CitySlug)</td>
                        <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">@r.SearchCount</td>
                        <td class="px-4 py-3 text-xs text-slate-500 dark:text-white/60">@r.LastSearchedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <a href="?editId=@r.Id" class="glass-button text-xs py-1 px-2">@L["admin.specialsEdit"]</a>
                                <form method="post" asp-page-handler="Delete" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@r.Id" />
                                    <button type="submit" class="glass-button text-xs py-1 px-2 text-rose-600 dark:text-rose-300">@L["admin.searchesDelete"]</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500 dark:text-white/50">@L["admin.noResults"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-xs text-slate-500 dark:text-white/50">@L["admin.searchesTopHint"]</p>
</div>
