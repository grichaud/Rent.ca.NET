@model IReadOnlyList<Rent.Web.Domain.PropertyImage>

@if (Model.Count == 0)
{
    <div class="glass-card p-10 text-center text-slate-500 dark:text-white/60">No photos yet.</div>
    return;
}

@{
    var hero = Model.First();
    var rest = Model.Skip(1).Take(4).ToList();
}

<section class="grid sm:grid-cols-4 gap-2 aspect-[16/9] overflow-hidden rounded-3xl ring-1 ring-gray-200 dark:ring-white/10">
    <div class="relative sm:col-span-2 sm:row-span-2 bg-gradient-to-br from-brand-200 to-cyan-200 dark:from-brand-900/40 dark:to-cyan-900/40 group">
        <img src="@hero.Url" alt="@hero.AltText" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
    </div>
    @foreach (var img in rest)
    {
        <div class="relative bg-gradient-to-br from-purple-200 to-pink-200 dark:from-purple-900/40 dark:to-pink-900/40 hidden sm:block group">
            <img src="@img.Url" alt="@img.AltText" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
        </div>
    }
</section>
