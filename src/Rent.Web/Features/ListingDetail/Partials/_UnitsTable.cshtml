@model IEnumerable<Rent.Web.Domain.Unit>

<section class="glass-card p-6">
    <h2 class="font-semibold text-slate-900 mb-4">Available units</h2>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-slate-500 text-xs uppercase tracking-wider">
                    <th class="py-2 pr-4">Plan</th>
                    <th class="py-2 pr-4">Beds</th>
                    <th class="py-2 pr-4">Baths</th>
                    <th class="py-2 pr-4">Sq ft</th>
                    <th class="py-2 pr-4">Price</th>
                    <th class="py-2 pr-4">Available</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70">
                @foreach (var u in Model.OrderBy(u => u.Price))
                {
                    <tr class="text-slate-800">
                        <td class="py-3 pr-4 font-medium">@(u.Name ?? (u.Bedrooms == 0 ? "Studio" : $"{u.Bedrooms} BR"))</td>
                        <td class="py-3 pr-4">@(u.Bedrooms == 0 ? "Studio" : u.Bedrooms.ToString())</td>
                        <td class="py-3 pr-4">@u.Bathrooms.ToString("0.#")</td>
                        <td class="py-3 pr-4">@(u.SqFt?.ToString("N0") ?? "&mdash;")</td>
                        <td class="py-3 pr-4 font-semibold">$@u.Price.ToString("N0")@(u.PriceMax.HasValue ? $"-{u.PriceMax.Value:N0}" : "")/mo</td>
                        <td class="py-3 pr-4 text-slate-600">@(u.AvailableDate?.ToString("MMM d, yyyy") ?? "Now")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
