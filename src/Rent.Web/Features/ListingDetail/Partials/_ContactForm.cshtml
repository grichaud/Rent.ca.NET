@model Rent.Web.Features.ListingDetail.Pages.DetailModel

@if (TempData["InquirySuccess"] as string is string success)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl p-3 mb-4">@success</div>
}

<form method="post" action="/inquiries/submit" class="space-y-3 text-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PropertyId" value="@Model.Property!.Id" />
    <input type="hidden" name="ReturnCitySlug" value="@Model.CitySlug" />
    <input type="hidden" name="ReturnPropertySlug" value="@Model.Property!.Slug" />

    <h3 class="font-semibold text-slate-900">Contact the landlord</h3>

    <div>
        <label for="SenderName" class="block text-xs text-slate-500 mb-1">Your name</label>
        <input id="SenderName" name="SenderName" required class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="SenderEmail" class="block text-xs text-slate-500 mb-1">Email</label>
        <input id="SenderEmail" name="SenderEmail" type="email" required class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="SenderPhone" class="block text-xs text-slate-500 mb-1">Phone (optional)</label>
        <input id="SenderPhone" name="SenderPhone" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="MoveInDate" class="block text-xs text-slate-500 mb-1">Move-in date</label>
        <input id="MoveInDate" name="MoveInDate" type="date" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="Message" class="block text-xs text-slate-500 mb-1">Message</label>
        <textarea id="Message" name="Message" rows="4" required class="glass-input !py-2 !text-sm"></textarea>
    </div>
    <button type="submit" class="glass-button-primary w-full">Send inquiry</button>
</form>
