@model Rent.Web.Features.ListingDetail.Pages.DetailModel
@{
    var prefilledMessage = string.Format(L["detail.prefillMessage"].Value, Model.Property!.Title);
}

@if (TempData["InquirySuccess"] as string is string success)
{
    <div class="bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-700/40 text-emerald-800 dark:text-emerald-200 text-sm rounded-xl p-3 mb-4">@success</div>
}

<form method="post" action="/inquiries/submit" class="space-y-3 text-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PropertyId" value="@Model.Property!.Id" />
    <input type="hidden" name="ReturnCitySlug" value="@Model.CitySlug" />
    <input type="hidden" name="ReturnPropertySlug" value="@Model.Property!.Slug" />

    <h3 class="font-semibold text-slate-900 dark:text-white inline-flex items-center gap-2">
        <icon name="mail" class="h-4 w-4 text-brand-500" />
        @L["detail.contactLandlordTitle"]
    </h3>

    <div>
        <label for="SenderName" class="block text-xs text-slate-500 dark:text-white/50 mb-1">@L["detail.formName"] <span class="text-red-500">*</span></label>
        <input id="SenderName" name="SenderName" required autocomplete="name" placeholder="@L["auth.fullNamePlaceholder"]" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="SenderEmail" class="block text-xs text-slate-500 dark:text-white/50 mb-1">@L["auth.email"] <span class="text-red-500">*</span></label>
        <input id="SenderEmail" name="SenderEmail" type="email" required autocomplete="email" placeholder="@L["auth.emailPlaceholder"]" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="SenderPhone" class="block text-xs text-slate-500 dark:text-white/50 mb-1">@L["detail.formPhone"]</label>
        <input id="SenderPhone" name="SenderPhone" type="tel" autocomplete="tel" placeholder="(416) 555-0100" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="MoveInDate" class="block text-xs text-slate-500 dark:text-white/50 mb-1">@L["detail.formMoveIn"]</label>
        <input id="MoveInDate" name="MoveInDate" type="date" class="glass-input !py-2 !text-sm" />
    </div>
    <div>
        <label for="Message" class="block text-xs text-slate-500 dark:text-white/50 mb-1">@L["detail.formMessage"] <span class="text-red-500">*</span></label>
        <textarea id="Message" name="Message" rows="4" required class="glass-input !py-2 !text-sm">@prefilledMessage</textarea>
    </div>
    <button type="submit" class="glass-button-primary w-full">@L["detail.sendMessage"]</button>
</form>
