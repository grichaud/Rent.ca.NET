@page "/{citySlug}/{propertySlug}"
@model Rent.Web.Features.ListingDetail.Pages.DetailModel
@{
    ViewData["Title"] = Model.Property?.Title ?? "Listing not found";
}

@if (Model.Property is null)
{
    <section class="max-w-xl mx-auto glass-card p-10 text-center">
        <h1 class="font-display text-3xl text-slate-900 dark:text-white">Listing not found</h1>
        <p class="text-slate-500 dark:text-white/60 mt-2">This listing is no longer available.</p>
        <a href="/" class="glass-button-primary inline-block mt-6">Back home</a>
    </section>
    return;
}

@{
    var p = Model.Property;
    var orderedImages = p.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.DisplayOrder).ToList();
    var minPrice = p.Units.OrderBy(u => u.Price).FirstOrDefault()?.Price;
    var amenityGroups = p.Amenities.GroupBy(a => a.Category ?? "other").OrderBy(g => g.Key);
}

<nav class="text-sm text-slate-500 dark:text-white/50 mb-4 inline-flex items-center gap-2">
    <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
    <span class="opacity-50">/</span>
    <a href="/@Model.CitySlug" class="hover:text-brand-600 dark:hover:text-brand-400">@p.City</a>
    <span class="opacity-50">/</span>
    <span class="text-slate-700 dark:text-white/80 truncate max-w-[40ch]">@p.Title</span>
</nav>

<partial name="/Features/ListingDetail/Partials/_Gallery.cshtml" model="orderedImages" />

<section class="grid lg:grid-cols-[1fr_400px] gap-8 mt-8">
    <article class="space-y-6">
        <header>
            <div class="flex items-start justify-between gap-3">
                <h1 class="font-display text-4xl text-slate-900 dark:text-white">@p.Title</h1>
                @if (Model.IsAuthenticated)
                {
                    <form method="post" action="/renter/favorites/toggle" class="shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="/@Model.CitySlug/@p.Slug" />
                        <button type="submit"
                                data-favorite-toggle
                                data-property-id="@p.Id"
                                data-favorited="@(Model.IsFavorited ? "true" : "false")"
                                aria-label="@(Model.IsFavorited ? "Remove from favorites" : "Save to favorites")"
                                aria-pressed="@(Model.IsFavorited ? "true" : "false")"
                                class="@(Model.IsFavorited ? "h-11 w-11 inline-flex items-center justify-center rounded-full bg-rose-50 dark:bg-rose-500/20 text-rose-500 hover:scale-110 transition-all duration-200 shadow-sm" : "h-11 w-11 inline-flex items-center justify-center rounded-full bg-white/80 dark:bg-slate-900/60 backdrop-blur-md text-slate-700 dark:text-white/80 hover:text-rose-500 hover:scale-110 transition-all duration-200 shadow-sm border border-gray-200 dark:border-white/10")">
                            <icon name="heart" class="h-5 w-5" fill="@(Model.IsFavorited ? "currentColor" : null)" />
                        </button>
                    </form>
                }
                else
                {
                    <a href="/login?returnUrl=@Uri.EscapeDataString($"/{Model.CitySlug}/{p.Slug}")"
                       class="h-11 w-11 inline-flex items-center justify-center rounded-full bg-white/80 dark:bg-slate-900/60 backdrop-blur-md text-slate-700 dark:text-white/80 hover:text-rose-500 hover:scale-110 transition-all duration-200 shadow-sm border border-gray-200 dark:border-white/10 shrink-0"
                       aria-label="Log in to save to favorites" title="Log in to save">
                        <icon name="heart" class="h-5 w-5" />
                    </a>
                }
            </div>
            <p class="text-slate-600 dark:text-white/60 mt-2 inline-flex items-start gap-1.5">
                <icon name="map-pin" class="h-4 w-4 mt-1 shrink-0 text-brand-500" />
                <span>@p.StreetAddress, @(p.Neighbourhood is null ? "" : p.Neighbourhood + ", ")@p.City, @p.Province @p.PostalCode</span>
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
                <span class="glass-badge inline-flex items-center gap-1">
                    <icon name="home" class="h-3.5 w-3.5" />
                    @p.PropertyType
                </span>
                @if (p.PetsAllowed)
                {
                    <span class="glass-badge inline-flex items-center gap-1 !bg-brand-50 !border-brand-200 !text-brand-700 dark:!bg-brand-900/40 dark:!border-brand-700/40 dark:!text-brand-200">
                        <icon name="dog" class="h-3.5 w-3.5" /> Pet friendly
                    </span>
                }
                @if (p.Furnished)
                {
                    <span class="glass-badge inline-flex items-center gap-1">
                        <icon name="sofa" class="h-3.5 w-3.5" /> Furnished
                    </span>
                }
                @if (p.IsVerified)
                {
                    <span class="glass-badge inline-flex items-center gap-1 !bg-emerald-50 !border-emerald-200 !text-emerald-700 dark:!bg-emerald-900/40 dark:!border-emerald-700/40 dark:!text-emerald-200">
                        <icon name="check" class="h-3.5 w-3.5" /> Verified
                    </span>
                }
            </div>
        </header>

        <section class="glass-card p-6">
            <h2 class="font-semibold text-slate-900 dark:text-white mb-3">About this listing</h2>
            <p class="text-slate-700 dark:text-white/80 whitespace-pre-line">@p.Description</p>
        </section>

        <partial name="/Features/ListingDetail/Partials/_UnitsTable.cshtml" model="p.Units" />

        @if (amenityGroups.Any())
        {
            <section class="glass-card p-6">
                <h2 class="font-semibold text-slate-900 dark:text-white mb-4">Amenities</h2>
                <div class="space-y-4">
                    @foreach (var group in amenityGroups)
                    {
                        <div>
                            <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-white/50 mb-2">@group.Key</div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var a in group)
                                {
                                    <span class="glass-badge">@a.Name</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </article>

    <aside class="lg:sticky lg:top-24 h-fit">
        <div class="glass-card p-6">
            @if (minPrice.HasValue)
            {
                <div class="mb-4 pb-4 border-b border-gray-200 dark:border-white/10">
                    <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-white/50">From</div>
                    <div class="font-display text-3xl text-slate-900 dark:text-white">$@minPrice.Value.ToString("N0")<span class="text-base text-slate-500 dark:text-white/50">/mo</span></div>
                </div>
            }
            <partial name="/Features/ListingDetail/Partials/_ContactForm.cshtml" model="Model" />
        </div>
    </aside>
</section>
