@page "/{citySlug}/{propertySlug}"
@model Rent.Web.Features.ListingDetail.Pages.DetailModel
@{
    ViewData["Title"] = Model.Property?.Title ?? "Listing not found";
}

@if (Model.Property is null)
{
    <section class="max-w-xl mx-auto glass-card p-10 text-center">
        <h1 class="font-display text-3xl text-slate-900">Listing not found</h1>
        <p class="text-slate-500 mt-2">This listing is no longer available.</p>
        <a href="/" class="glass-button-primary inline-block mt-6">Back home</a>
    </section>
    return;
}

@{
    var p = Model.Property;
    var orderedImages = p.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.DisplayOrder).ToList();
    var minPrice = p.Units.OrderBy(u => u.Price).FirstOrDefault()?.Price;
    var amenityGroups = p.Amenities.GroupBy(a => a.Category ?? "other").OrderBy(g => g.Key);
}

<nav class="text-sm text-slate-500 mb-4">
    <a href="/" class="hover:underline">Home</a>
    <span class="mx-2">/</span>
    <a href="/@Model.CitySlug" class="hover:underline">@p.City</a>
    <span class="mx-2">/</span>
    <span class="text-slate-700">@p.Title</span>
</nav>

<partial name="/Features/ListingDetail/Partials/_Gallery.cshtml" model="orderedImages" />

<section class="grid lg:grid-cols-[1fr_400px] gap-8 mt-8">
    <article class="space-y-6">
        <header>
            <h1 class="font-display text-4xl text-slate-900">@p.Title</h1>
            <p class="text-slate-600 mt-2">@p.StreetAddress, @(p.Neighbourhood is null ? "" : p.Neighbourhood + ", ")@p.City, @p.Province @p.PostalCode</p>
            <div class="flex gap-2 mt-3">
                <span class="px-2 py-1 bg-white/70 border border-white/60 rounded-lg text-xs text-slate-700">@p.PropertyType</span>
                @if (p.PetsAllowed)
                {
                    <span class="px-2 py-1 bg-brand-50 border border-brand-200 rounded-lg text-xs text-brand-700">Pet friendly</span>
                }
                @if (p.IsVerified)
                {
                    <span class="px-2 py-1 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-700">Verified</span>
                }
            </div>
        </header>

        <section class="glass-card p-6">
            <h2 class="font-semibold text-slate-900 mb-3">About this listing</h2>
            <p class="text-slate-700 whitespace-pre-line">@p.Description</p>
        </section>

        <partial name="/Features/ListingDetail/Partials/_UnitsTable.cshtml" model="p.Units" />

        @if (amenityGroups.Any())
        {
            <section class="glass-card p-6">
                <h2 class="font-semibold text-slate-900 mb-4">Amenities</h2>
                <div class="space-y-4">
                    @foreach (var group in amenityGroups)
                    {
                        <div>
                            <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">@group.Key</div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var a in group)
                                {
                                    <span class="px-3 py-1 bg-white/70 border border-white/60 rounded-full text-sm text-slate-700">@a.Name</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </article>

    <aside class="lg:sticky lg:top-24 h-fit">
        <div class="glass-card p-6">
            @if (minPrice.HasValue)
            {
                <div class="mb-4">
                    <div class="text-xs text-slate-500">From</div>
                    <div class="font-display text-3xl text-slate-900">$@minPrice.Value.ToString("N0")<span class="text-base text-slate-500">/mo</span></div>
                </div>
            }
            <partial name="/Features/ListingDetail/Partials/_ContactForm.cshtml" model="Model" />
        </div>
    </aside>
</section>
