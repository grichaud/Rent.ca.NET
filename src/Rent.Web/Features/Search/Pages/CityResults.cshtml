@page "/{culture:locale}/{citySlug}"
@model Rent.Web.Features.Search.Pages.CityResultsModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
    ViewData["Title"] = Model.Result.City is null
        ? "City not found"
        : L["listings.rentalsIn"].Value + " " + Model.Result.City.Name;
    var view = Model.Query.View;
    var isMap = view == Rent.Web.Features.Search.SearchView.Map;
    var isList = view == Rent.Web.Features.Search.SearchView.List;
}

@if (Model.Result.City is null)
{
    <section class="max-w-xl mx-auto glass-card p-10 text-center">
        <h1 class="font-sans font-bold tracking-tight text-3xl text-slate-900 dark:text-white">City not found</h1>
        <p class="text-slate-500 dark:text-white/60 mt-2">We couldn&rsquo;t find a city with that name.</p>
        <a href="/@culture" class="glass-button-primary inline-block mt-6">@L["common.back"]</a>
    </section>
    return;
}

<header class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-1">
        @L["listings.rentalsIn"]
        <span class="bg-gradient-to-r from-brand-500 to-cyan-500 dark:from-brand-400 dark:to-cyan-400 bg-clip-text text-transparent">
            @Model.Result.City.Name
        </span>
    </h1>
    <p class="text-sm text-gray-500 dark:text-white/50 mb-4">
        @string.Format(L["listings.findIn"].Value, Model.Result.City.Name)
    </p>
    <partial name="/Features/Search/Partials/_SearchBarCompact.cshtml" model="@Model.Result.City.Name" />
</header>

<div class="lg:grid lg:grid-cols-[288px_1fr] lg:gap-6 items-start">
    <aside class="hidden lg:block">
        <partial name="/Features/Search/Partials/_SidebarFilters.cshtml" model="Model.Query" />
    </aside>

    <div class="flex flex-col gap-4 min-w-0">
        @* Mobile filter trigger *@
        <button type="button"
                data-mobile-filter-open
                class="glass-button lg:hidden inline-flex items-center justify-center gap-2 px-4 py-2 text-sm text-gray-800 dark:text-white/80 self-start">
            <icon name="sliders-horizontal" class="h-4 w-4" />
            @L["filters.openFilters"]
        </button>

        <partial name="/Features/Search/Partials/_ResultsHeader.cshtml" model="Model" />

        @if (Model.Result.Properties.Count == 0)
        {
            <div class="glass-card p-10 text-center text-slate-600 dark:text-white/70">
                @L["results.empty"] <a href="/@culture/@Model.Query.CitySlug" class="text-brand-600 dark:text-brand-400 underline">@L["filters.clear"]</a>.
            </div>
        }
        else
        {
            @* Grid / List view container; hidden when Map view is active *@
            <div id="rentca-results-list"
                 class="@(isMap ? "hidden " : "")@(isList ? "grid grid-cols-1 gap-4" : "grid sm:grid-cols-2 xl:grid-cols-3 gap-5")">
                @foreach (var p in Model.Result.Properties)
                {
                    <partial name="/Features/Search/Partials/_PropertyCard.cshtml" model="p" view-data='new ViewDataDictionary(ViewData) { ["Variant"] = (isList ? "list" : "grid") }' />
                }
            </div>

            <div id="rentca-search-map"
                 class="@(isMap ? "" : "hidden ")glass-card overflow-hidden p-0 h-[600px] w-full"
                 data-city-slug="@Model.Query.CitySlug"
                 data-city-lat="@(Model.Result.City.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                 data-city-lng="@(Model.Result.City.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
            </div>
        }
    </div>
</div>

@* Mobile filter drawer overlay (hidden on desktop) *@
<div id="rentca-mobile-filters" class="lg:hidden fixed inset-0 z-50 pointer-events-none" aria-hidden="true">
    <div data-mobile-filter-overlay class="absolute inset-0 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <aside class="absolute top-0 left-0 bottom-0 w-80 max-w-[90vw] translate-x-[-100%] transition-transform duration-300 ease-out overflow-y-auto" data-mobile-filter-panel>
        <div class="p-3">
            <partial name="/Features/Search/Partials/_SidebarFilters.cshtml" model="Model.Query" />
        </div>
    </aside>
</div>
