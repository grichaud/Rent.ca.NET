@model Rent.Web.Features.Search.Pages.CityResultsModel
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
    var totalCount = Model.Result.TotalCount;
    var cityName = Model.Result.City?.Name ?? Model.Query.CitySlug;

    var sortOptions = new (Rent.Web.Features.Search.SearchSort Value, string Label)[]
    {
        (Rent.Web.Features.Search.SearchSort.Newest,   L["sort.newest"].Value),
        (Rent.Web.Features.Search.SearchSort.PriceAsc, L["sort.priceAsc"].Value),
        (Rent.Web.Features.Search.SearchSort.PriceDesc,L["sort.priceDesc"].Value),
        (Rent.Web.Features.Search.SearchSort.Popular,  L["sort.popular"].Value),
    };

    var viewOptions = new (Rent.Web.Features.Search.SearchView Value, string Icon, string Label)[]
    {
        (Rent.Web.Features.Search.SearchView.Grid, "grid-3x3", L["filters.viewGrid"].Value),
        (Rent.Web.Features.Search.SearchView.List, "list",     L["filters.viewList"].Value),
        (Rent.Web.Features.Search.SearchView.Map,  "map",      L["filters.viewMap"].Value),
    };

    // Build the count line with typographic hierarchy: number emphasized, connector muted
    // (inherited from the <p>), city medium. Values are HTML-encoded; the format template
    // comes from the trusted resource file, so Html.Raw on the composed string is safe.
    var numberSpan = "<span class=\"font-semibold text-base text-gray-900 dark:text-white\">"
                     + System.Net.WebUtility.HtmlEncode(totalCount.ToString("N0")) + "</span>";
    var citySpan = "<span class=\"font-medium text-gray-900 dark:text-white\">"
                   + System.Net.WebUtility.HtmlEncode(cityName) + "</span>";
    var resultsHtml = totalCount == 1
        ? string.Format(L["results.headerCountSingular"].Value, citySpan)
        : string.Format(L["results.headerCountPlural"].Value, numberSpan, citySpan);
}

<div class="glass-base flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-4 py-3"
     aria-label="Search results controls"
     data-results-header
     data-base-url="/@culture/@Model.Query.CitySlug">

    <p class="text-sm text-gray-600 dark:text-white/70">
        @Html.Raw(resultsHtml)
    </p>

    <div class="flex flex-wrap items-center justify-end gap-2 sm:flex-nowrap sm:flex-shrink-0">
        <select data-sort-select
                aria-label="@L["filters.sortBy"]"
                class="glass-button h-9 min-w-[140px] sm:min-w-[160px] text-sm text-gray-700 dark:text-white/80 border-gray-200 dark:border-white/20 cursor-pointer pr-8">
            @foreach (var opt in sortOptions)
            {
                <option value="@opt.Value" selected="@(opt.Value == Model.Query.Sort)">@opt.Label</option>
            }
        </select>

        <div class="glass-base flex items-center p-1 gap-0.5" role="group" aria-label="Switch view mode">
            @foreach (var v in viewOptions)
            {
                var isActive = Model.Query.View == v.Value;
                <button type="button"
                        data-view-btn="@v.Value"
                        aria-label="@v.Label"
                        aria-pressed="@(isActive ? "true" : "false")"
                        class="h-7 w-7 rounded-lg flex items-center justify-center transition-all duration-200 @(isActive ? "bg-brand-500/20 dark:bg-brand-500/30 text-brand-700 dark:text-brand-300 shadow-sm shadow-brand-500/10 dark:shadow-brand-500/30 border border-brand-500/30" : "text-gray-600 dark:text-white/50 hover:text-gray-800 dark:hover:text-white/80 hover:bg-gray-200 dark:hover:bg-white/10")">
                    <icon name="@v.Icon" class="h-3.5 w-3.5" />
                </button>
            }
        </div>
    </div>
</div>
