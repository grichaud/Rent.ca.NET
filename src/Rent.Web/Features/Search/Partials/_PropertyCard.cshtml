@model Rent.Web.Features.Search.PropertyCard
@{
    var variant = ViewData["Variant"] as string ?? "grid";
    var isList = variant == "list";

    string FormatPrice(decimal v) => "$" + v.ToString("N0");
    string PriceLabel()
    {
        if (!Model.FromPrice.HasValue) return "Contact for pricing";
        if (Model.ToPrice.HasValue && Model.ToPrice.Value > Model.FromPrice.Value)
            return $"{FormatPrice(Model.FromPrice.Value)} – {FormatPrice(Model.ToPrice.Value)}/mo";
        return $"{FormatPrice(Model.FromPrice.Value)}/mo";
    }
    string BedsLabel()
    {
        if (Model.MinBedrooms == 0 && (!Model.MaxBedrooms.HasValue || Model.MaxBedrooms == 0)) return "Studio";
        if (Model.MaxBedrooms.HasValue && Model.MaxBedrooms.Value > Model.MinBedrooms)
            return $"{Model.MinBedrooms}–{Model.MaxBedrooms} bd";
        return $"{Model.MinBedrooms} bd";
    }
    string BathsLabel()
    {
        var n = Model.MinBathrooms;
        if (n <= 0) return "1 ba";
        return n == Math.Floor(n) ? $"{(int)n} ba" : $"{n:0.0} ba";
    }
    string LocationLabel()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Neighbourhood)) parts.Add(Model.Neighbourhood);
        parts.Add(Model.City);
        parts.Add(Model.Province);
        return string.Join(", ", parts);
    }
    string DetailUrl() => $"/{Model.CitySlug}/{Model.Slug}";
}

@if (isList)
{
    <article class="glass-card flex flex-col sm:flex-row overflow-hidden hover:scale-[1.01] transition-all duration-300 hover:shadow-2xl hover:shadow-brand-500/10 p-0">
        <a href="@DetailUrl()" class="relative w-full sm:w-72 h-48 sm:h-auto shrink-0 overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" alt="@Model.Title" loading="lazy"
                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
            }
            else
            {
                <div class="absolute inset-0 bg-gradient-to-br from-brand-500/20 via-purple-500/15 to-cyan-500/20 flex items-center justify-center">
                    <icon name="map-pin" class="h-7 w-7 text-white/40" />
                </div>
            }
            <div class="absolute inset-0 bg-gradient-to-r from-transparent to-black/20" aria-hidden="true"></div>
        </a>
        <div class="flex flex-col flex-1 p-5 gap-3">
            <div class="flex items-start justify-between gap-3">
                <div class="flex flex-wrap gap-1.5">
                    @{ await Html.RenderPartialAsync("/Features/Search/Partials/_PropertyBadges.cshtml", Model); }
                </div>
                <button type="button"
                        data-favorite-toggle
                        data-property-id="@Model.Id"
                        data-favorited="@(Model.IsFavorited ? "true" : "false")"
                        aria-label="@(Model.IsFavorited ? "Remove from favorites" : "Add to favorites")"
                        aria-pressed="@(Model.IsFavorited ? "true" : "false")"
                        class="shrink-0 h-8 w-8 rounded-full inline-flex items-center justify-center bg-gray-100 dark:bg-white/10 hover:bg-gray-200 dark:hover:bg-white/20 backdrop-blur-md border border-gray-200 dark:border-white/20 transition-all duration-200 hover:scale-110">
                    <icon name="heart" class="@(Model.IsFavorited ? "h-4 w-4 text-rose-400" : "h-4 w-4 text-gray-500 dark:text-white/60")"
                          fill="@(Model.IsFavorited ? "currentColor" : null)" />
                </button>
            </div>
            <div>
                <p class="text-xl font-bold text-gray-900 dark:text-white">@PriceLabel()</p>
                <a href="@DetailUrl()">
                    <h3 class="mt-1 text-base font-medium text-gray-700 dark:text-white/90 hover:text-gray-900 dark:hover:text-white transition-colors line-clamp-1">
                        @Model.Title
                    </h3>
                </a>
            </div>
            <p class="flex items-center gap-1.5 text-sm text-gray-500 dark:text-white/60">
                <icon name="map-pin" class="h-3.5 w-3.5 text-gray-400 dark:text-white/40 shrink-0" />
                @LocationLabel()
            </p>
            <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-white/70">
                <span class="inline-flex items-center gap-1"><icon name="bed" class="h-3.5 w-3.5" />@BedsLabel()</span>
                <span class="text-gray-300 dark:text-white/20">·</span>
                <span class="inline-flex items-center gap-1"><icon name="bath" class="h-3.5 w-3.5" />@BathsLabel()</span>
                <span class="text-gray-300 dark:text-white/20">·</span>
                <span class="inline-flex items-center gap-1"><icon name="home" class="h-3.5 w-3.5" />@Model.PropertyType</span>
            </div>
            @if (Model.PetsAllowed || Model.Furnished)
            {
                <div class="flex flex-wrap gap-1.5 mt-auto">
                    @if (Model.PetsAllowed)
                    {
                        <span class="glass-badge text-xs text-gray-500 dark:text-white/70 inline-flex items-center gap-1"><icon name="dog" class="h-3 w-3" />Pet-friendly</span>
                    }
                    @if (Model.Furnished)
                    {
                        <span class="glass-badge text-xs text-gray-500 dark:text-white/70 inline-flex items-center gap-1"><icon name="sofa" class="h-3 w-3" />Furnished</span>
                    }
                </div>
            }
        </div>
    </article>
    return;
}

@* Grid variant (default) *@
<article class="glass-card flex flex-col overflow-hidden p-0 hover:scale-[1.02] transition-all duration-300 hover:shadow-2xl hover:shadow-brand-500/10">
    <a href="@DetailUrl()" class="relative aspect-[4/3] overflow-hidden block group">
        @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
        {
            <img src="@Model.PrimaryImageUrl" alt="@Model.Title" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        }
        else
        {
            <div class="absolute inset-0 bg-gradient-to-br from-brand-500/20 via-purple-500/15 to-cyan-500/20 flex items-center justify-center">
                <icon name="map-pin" class="h-7 w-7 text-white/40" />
            </div>
        }
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" aria-hidden="true"></div>

        @* Tier + Special badges top-left *@
        <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
            @{ await Html.RenderPartialAsync("/Features/Search/Partials/_PropertyBadges.cshtml", Model); }
        </div>

        @* Heart + Verified top-right *@
        <div class="absolute top-3 right-3 flex flex-col gap-1.5 items-end">
            <button type="button"
                    data-favorite-toggle
                    data-property-id="@Model.Id"
                    data-favorited="@(Model.IsFavorited ? "true" : "false")"
                    onclick="event.preventDefault(); event.stopPropagation();"
                    aria-label="@(Model.IsFavorited ? "Remove from favorites" : "Add to favorites")"
                    aria-pressed="@(Model.IsFavorited ? "true" : "false")"
                    class="h-8 w-8 rounded-full inline-flex items-center justify-center bg-black/30 hover:bg-black/50 backdrop-blur-md border border-white/20 transition-all duration-200 hover:scale-110">
                <icon name="heart" class="@(Model.IsFavorited ? "h-4 w-4 text-rose-400" : "h-4 w-4 text-white/80")"
                      fill="@(Model.IsFavorited ? "currentColor" : null)" />
            </button>
            @if (Model.IsVerified)
            {
                <span class="inline-flex items-center gap-1 bg-emerald-500/90 backdrop-blur-md text-white text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md">
                    <icon name="check" class="h-3 w-3" />
                    Verified
                </span>
            }
        </div>
    </a>

    <div class="flex flex-col gap-2.5 p-4">
        <div>
            <p class="text-lg font-bold text-gray-900 dark:text-white leading-tight">@PriceLabel()</p>
            <a href="@DetailUrl()">
                <h3 class="mt-0.5 text-sm font-medium text-gray-700 dark:text-white/80 hover:text-gray-900 dark:hover:text-white transition-colors line-clamp-1">
                    @Model.Title
                </h3>
            </a>
        </div>

        <p class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-white/60">
            <icon name="map-pin" class="h-3 w-3 text-gray-400 dark:text-white/40 shrink-0" />
            <span class="truncate">@LocationLabel()</span>
        </p>

        <div class="flex items-center gap-2 text-xs text-gray-600 dark:text-white/70">
            <span class="inline-flex items-center gap-1"><icon name="bed" class="h-3 w-3" />@BedsLabel()</span>
            <span class="text-gray-300 dark:text-white/20">·</span>
            <span class="inline-flex items-center gap-1"><icon name="bath" class="h-3 w-3" />@BathsLabel()</span>
            <span class="text-gray-300 dark:text-white/20">·</span>
            <span class="inline-flex items-center gap-1"><icon name="home" class="h-3 w-3" />@Model.PropertyType</span>
        </div>

        @if (Model.PetsAllowed || Model.Furnished)
        {
            <div class="flex flex-wrap gap-1.5 pt-1 border-t border-gray-200 dark:border-white/10">
                @if (Model.PetsAllowed)
                {
                    <span class="glass-badge text-xs text-gray-500 dark:text-white/60 inline-flex items-center gap-1 py-0.5"><icon name="dog" class="h-3 w-3" />Pet-friendly</span>
                }
                @if (Model.Furnished)
                {
                    <span class="glass-badge text-xs text-gray-500 dark:text-white/60 inline-flex items-center gap-1 py-0.5"><icon name="sofa" class="h-3 w-3" />Furnished</span>
                }
            </div>
        }
    </div>
</article>
