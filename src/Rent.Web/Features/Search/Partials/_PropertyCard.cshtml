@model Rent.Web.Features.Search.PropertyCard
@{
    string BedsLabel(int n) => n == 0 ? "Studio" : $"{n}+";
    string BathsLabel(decimal n)
    {
        if (n <= 0m) return "—";
        return n == Math.Floor(n) ? n.ToString("0") : n.ToString("0.0");
    }
}

<a href="/@Model.CitySlug/@Model.Slug"
   class="group glass-card overflow-hidden flex flex-col p-0 hover:scale-[1.02] hover:shadow-2xl hover:shadow-brand-500/20 transition-all duration-300">

    <div class="relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-brand-200 via-purple-200 to-cyan-200 dark:from-brand-900/40 dark:via-purple-900/40 dark:to-cyan-900/40">
        @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
        {
            <img src="@Model.PrimaryImageUrl" alt="@Model.Title"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                 loading="lazy" />
        }
        else
        {
            <div class="absolute inset-0 flex items-center justify-center text-white/80">
                <icon name="building" class="h-16 w-16" />
            </div>
        }

        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0 pointer-events-none"></div>

        <div class="absolute top-3 left-3 flex flex-col items-start gap-1.5">
            @if (Model.Tier == Rent.Web.Domain.ListingTier.Featured)
            {
                <span class="inline-flex items-center gap-1 bg-gradient-to-r from-brand-500 to-cyan-500 text-white text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md shadow-lg shadow-brand-500/40">
                    <icon name="sparkles" class="h-3 w-3" />
                    Featured
                </span>
            }
            else if (Model.Tier == Rent.Web.Domain.ListingTier.Promoted)
            {
                <span class="bg-slate-900/80 backdrop-blur-sm text-white text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md">Promoted</span>
            }
            @if (Model.IsVerified)
            {
                <span class="inline-flex items-center gap-1 bg-emerald-500/90 backdrop-blur-sm text-white text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md">
                    <icon name="check" class="h-3 w-3" />
                    Verified
                </span>
            }
        </div>

        <button type="button"
                class="absolute top-3 right-3 h-9 w-9 inline-flex items-center justify-center rounded-full bg-white/80 dark:bg-slate-900/60 backdrop-blur-md text-slate-700 dark:text-white/80 hover:text-rose-500 hover:scale-110 transition-all duration-200"
                onclick="event.preventDefault(); event.stopPropagation();"
                aria-label="Save to favorites" title="Save (coming soon)">
            <icon name="heart" class="h-4 w-4" />
        </button>

        <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between text-white">
            @if (Model.FromPrice.HasValue)
            {
                <div>
                    <div class="text-[10px] uppercase tracking-wider opacity-80">From</div>
                    <div class="font-display text-2xl leading-none">$@Model.FromPrice.Value.ToString("N0")<span class="text-xs opacity-80">/mo</span></div>
                </div>
            }
            <div class="flex flex-wrap gap-1.5 justify-end">
                @if (Model.PetsAllowed)
                {
                    <span class="inline-flex items-center gap-1 bg-white/20 backdrop-blur-md text-white text-[10px] font-medium px-2 py-1 rounded-md border border-white/20">
                        <icon name="dog" class="h-3 w-3" /> Pets
                    </span>
                }
                @if (Model.Furnished)
                {
                    <span class="inline-flex items-center gap-1 bg-white/20 backdrop-blur-md text-white text-[10px] font-medium px-2 py-1 rounded-md border border-white/20">
                        <icon name="sofa" class="h-3 w-3" /> Furnished
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="p-4 flex-1 flex flex-col">
        <div class="font-semibold text-slate-900 dark:text-white line-clamp-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            @Model.Title
        </div>
        <div class="mt-1 text-xs text-slate-500 dark:text-white/60 inline-flex items-center gap-1">
            <icon name="map-pin" class="h-3 w-3 shrink-0" />
            <span class="truncate">@(Model.Neighbourhood ?? Model.City), @Model.City</span>
        </div>

        <div class="mt-3 pt-3 border-t border-gray-200 dark:border-white/10 flex items-center gap-4 text-xs text-slate-600 dark:text-white/70">
            <span class="inline-flex items-center gap-1">
                <icon name="bed" class="h-3.5 w-3.5" />
                @BedsLabel(Model.MinBedrooms) bed
            </span>
            <span class="inline-flex items-center gap-1">
                <icon name="bath" class="h-3.5 w-3.5" />
                @BathsLabel(Model.MinBathrooms) bath
            </span>
            <span class="inline-flex items-center gap-1 ml-auto text-slate-500 dark:text-white/50">
                <icon name="home" class="h-3.5 w-3.5" />
                @Model.PropertyType
            </span>
        </div>
    </div>
</a>
