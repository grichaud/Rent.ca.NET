@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using Rent.Web.Domain
@using Rent.Web.Features.Maps
@using Rent.Web.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IOptions<MapsOptions> MapsOpts
@{
    var themeCookie = Context.Request.Cookies["rentca-theme"];
    var isDark = themeCookie != "light";
    var htmlClass = isDark ? "h-full dark" : "h-full";
    var colorScheme = isDark ? "dark light" : "light dark";
    var isLandlord = SignInManager.IsSignedIn(User) && User.IsInRole(Roles.Landlord);
    var isRenter = SignInManager.IsSignedIn(User) && User.IsInRole(Roles.Renter);
    var isAdmin = SignInManager.IsSignedIn(User) && User.IsInRole(Roles.Admin);
    var mapsKey = MapsOpts.Value.GoogleApiKey;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }
    var altCulture = culture == "fr" ? "en" : "fr";
    var currentPath = Context.Request.Path.HasValue ? Context.Request.Path.Value! : "/";
    var currentQuery = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty;
    var returnUrl = currentPath + currentQuery;
}
<!DOCTYPE html>
<html lang="@culture" class="@htmlClass">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@colorScheme" />
    <title>@(ViewData["Title"] ?? "Rent.ca") - Rent.ca</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" />
    @if (!string.IsNullOrWhiteSpace(mapsKey))
    {
        <meta name="rentca-maps-key" content="@mapsKey" />
    }
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/mobile-menu.js" asp-append-version="true" defer></script>
    <script src="~/js/favorite-toggle.js" asp-append-version="true" defer></script>
    <script src="~/js/ai-chat.js" asp-append-version="true" defer></script>
    <script src="~/js/maps.js" asp-append-version="true" defer></script>
    <script src="~/js/search-filters.js" asp-append-version="true" defer></script>
</head>
<body class="h-full font-sans text-slate-800 dark:text-white/90 antialiased mesh-background">

    <header class="sticky top-0 z-40 glass-navbar">
        <div class="max-w-7xl mx-auto h-16 px-4 sm:px-6 flex items-center justify-between gap-4">
            <a href="/@culture" class="flex items-center gap-1 group">
                <span class="text-2xl font-bold tracking-tight bg-gradient-to-r from-brand-500 to-cyan-500 bg-clip-text text-transparent">Rent</span>
                <span class="text-2xl font-bold tracking-tight bg-gradient-to-r from-brand-500 to-cyan-500 bg-clip-text text-transparent">.ca</span>
                <span class="ml-2 text-[10px] font-bold tracking-widest text-brand-600 dark:text-brand-400 border border-brand-500/40 rounded px-1.5 py-0.5">.NET</span>
            </a>

            <nav class="hidden md:flex items-center gap-1 text-sm">
                <a href="/@culture" class="px-3 py-2 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">@L["common.rent"]</a>
                <a href="/@culture/landlords" class="px-3 py-2 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">@L["common.landlords"]</a>
                <a href="/@culture/privacy" class="px-3 py-2 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">@L["common.about"]</a>
                @if (isAdmin)
                {
                    <a href="/@culture/admin" class="px-3 py-2 rounded-lg text-amber-600 dark:text-amber-300 font-medium hover:bg-amber-500/10 transition-colors">@L["admin.linkAdmin"]</a>
                }
                else if (isLandlord)
                {
                    <a href="/@culture/landlord" class="px-3 py-2 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">@L["common.dashboard"]</a>
                }
                else if (isRenter)
                {
                    <a href="/@culture/renter" class="px-3 py-2 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">@L["common.myPortal"]</a>
                }
            </nav>

            <div class="flex items-center gap-2">
                <form method="post" action="/set-language" class="hidden sm:inline-flex">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@altCulture" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 h-9 px-3 rounded-lg text-sm font-medium text-slate-600 dark:text-white/70 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors" title="@L["common.languageSwitcherTitle"]" aria-label="@L["common.languageSwitcherTitle"]">
                        <icon name="languages" class="h-4 w-4" />
                        <span class="text-xs font-bold tracking-wider">@culture.ToUpper()</span>
                    </button>
                </form>
                <button type="button" data-theme-toggle class="inline-flex items-center justify-center h-9 w-9 rounded-lg text-slate-600 dark:text-white/70 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors" title="@L["common.themeToggleTitle"]" aria-label="Toggle dark mode">
                    <icon name="sun" class="h-4 w-4 hidden dark:inline-block" />
                    <icon name="moon" class="h-4 w-4 inline-block dark:hidden" />
                </button>

                @if (SignInManager.IsSignedIn(User))
                {
                    <form method="post" action="/logout" class="hidden sm:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                            <icon name="log-out" class="h-4 w-4" />
                            <span>@L["common.logout"]</span>
                        </button>
                    </form>
                }
                else
                {
                    <a href="/@culture/login" class="hidden sm:inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="log-in" class="h-4 w-4" />
                        <span>@L["common.signIn"]</span>
                    </a>
                    <a href="/@culture/signup" class="hidden sm:inline-flex items-center gap-2 glass-button-primary text-sm">
                        <icon name="user-plus" class="h-4 w-4" />
                        <span>@L["common.signUp"]</span>
                    </a>
                }

                <button type="button" data-mobile-menu-open class="md:hidden inline-flex items-center justify-center h-9 w-9 rounded-lg text-slate-700 dark:text-white/80 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors" aria-label="@L["navbar.menu"]" aria-controls="mobile-drawer" aria-expanded="false">
                    <icon name="menu" class="h-5 w-5" />
                </button>
            </div>
        </div>
    </header>

    <div id="mobile-drawer" class="md:hidden fixed inset-0 z-50 pointer-events-none" aria-hidden="true">
        <div data-mobile-menu-overlay class="absolute inset-0 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

        <aside class="absolute top-0 right-0 bottom-0 w-72 max-w-[85vw] bg-white/95 dark:bg-slate-950/95 backdrop-blur-2xl border-l border-gray-200 dark:border-white/10 shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col" data-mobile-menu-panel>
            <div class="relative flex items-center justify-between p-5 border-b border-gray-200 dark:border-white/10">
                <span class="glass-highlight"></span>
                <a href="/@culture" class="flex items-center gap-1">
                    <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-brand-500 to-cyan-500 bg-clip-text text-transparent">Rent</span>
                    <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-brand-500 to-cyan-500 bg-clip-text text-transparent">.ca</span>
                    <span class="ml-2 text-[10px] font-bold tracking-widest text-brand-600 dark:text-brand-400 border border-brand-500/40 rounded px-1.5 py-0.5">.NET</span>
                </a>
                <button type="button" data-mobile-menu-close class="inline-flex items-center justify-center h-9 w-9 rounded-lg text-slate-600 dark:text-white/70 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors" aria-label="@L["navbar.close"]">
                    <icon name="x" class="h-5 w-5" />
                </button>
            </div>

            <nav class="flex flex-col gap-1 p-4" aria-label="Mobile">
                <a href="/@culture" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                    <icon name="home" class="h-4 w-4 shrink-0" />
                    <span class="font-medium">@L["common.rent"]</span>
                </a>
                <a href="/@culture/landlords" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                    <icon name="building" class="h-4 w-4 shrink-0" />
                    <span class="font-medium">@L["common.landlords"]</span>
                </a>
                <a href="/@culture/privacy" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                    <icon name="info" class="h-4 w-4 shrink-0" />
                    <span class="font-medium">@L["common.about"]</span>
                </a>
                @if (isAdmin)
                {
                    <a href="/@culture/admin" class="flex items-center gap-3 rounded-xl px-4 py-3 text-amber-600 dark:text-amber-300 font-medium hover:bg-amber-500/10 transition-colors">
                        <icon name="sparkles" class="h-4 w-4 shrink-0" />
                        <span>@L["admin.linkAdmin"]</span>
                    </a>
                }
                @if (isLandlord)
                {
                    <a href="/@culture/landlord" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="user" class="h-4 w-4 shrink-0" />
                        <span class="font-medium">@L["common.dashboard"]</span>
                    </a>
                    <a href="/@culture/landlord/inbox" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="mail" class="h-4 w-4 shrink-0" />
                        <span class="font-medium">@L["landlord.inboxTitle"]</span>
                    </a>
                }
                else if (isRenter)
                {
                    <a href="/@culture/renter" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="layout-dashboard" class="h-4 w-4 shrink-0" />
                        <span class="font-medium">@L["common.myPortal"]</span>
                    </a>
                    <a href="/@culture/renter/favorites" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="heart" class="h-4 w-4 shrink-0" />
                        <span class="font-medium">@L["renter.favoritesTitle"]</span>
                    </a>
                    <a href="/@culture/renter/alerts" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-700 dark:text-white/80 hover:text-slate-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                        <icon name="bell" class="h-4 w-4 shrink-0" />
                        <span class="font-medium">@L["renter.alertsTitle"]</span>
                    </a>
                }
            </nav>

            <div class="mt-auto p-4 border-t border-gray-200 dark:border-white/10 flex flex-col gap-2">
                <form method="post" action="/set-language" class="flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" name="culture" value="en" class="flex-1 glass-button text-xs font-bold tracking-wider @(culture == "en" ? "ring-2 ring-brand-500" : string.Empty)">EN</button>
                    <button type="submit" name="culture" value="fr" class="flex-1 glass-button text-xs font-bold tracking-wider @(culture == "fr" ? "ring-2 ring-brand-500" : string.Empty)">FR</button>
                </form>
                @if (SignInManager.IsSignedIn(User))
                {
                    <form method="post" action="/logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="glass-button w-full inline-flex items-center justify-center gap-2">
                            <icon name="log-out" class="h-4 w-4" />
                            <span>@L["common.logout"]</span>
                        </button>
                    </form>
                }
                else
                {
                    <a href="/@culture/login" class="glass-button w-full inline-flex items-center justify-center gap-2">
                        <icon name="log-in" class="h-4 w-4" />
                        <span>@L["common.signIn"]</span>
                    </a>
                    <a href="/@culture/signup" class="glass-button-primary w-full inline-flex items-center justify-center gap-2">
                        <icon name="user-plus" class="h-4 w-4" />
                        <span>@L["common.signUp"]</span>
                    </a>
                }
            </div>
        </aside>
    </div>

    @await RenderSectionAsync("Hero", required: false)

    <form id="rentca-csrf" class="hidden" aria-hidden="true">@Html.AntiForgeryToken()</form>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
        @RenderBody()
    </main>

    <footer class="mt-24 border-t border-gray-200 dark:border-white/10 bg-white/40 dark:bg-slate-900/40 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
            <div>
                <h4 class="font-semibold text-slate-900 dark:text-white mb-3">@L["common.search"]</h4>
                <ul class="space-y-2 text-slate-600 dark:text-white/60">
                    <li><a href="/@culture" class="hover:text-brand-600 dark:hover:text-brand-400">@L["cities.sectionTitle"]</a></li>
                    <li><a href="/@culture/toronto" class="hover:text-brand-600 dark:hover:text-brand-400">Toronto</a></li>
                    <li><a href="/@culture/montreal" class="hover:text-brand-600 dark:hover:text-brand-400">Montreal</a></li>
                    <li><a href="/@culture/vancouver" class="hover:text-brand-600 dark:hover:text-brand-400">Vancouver</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-semibold text-slate-900 dark:text-white mb-3">@L["footer.forLandlords"]</h4>
                <ul class="space-y-2 text-slate-600 dark:text-white/60">
                    <li><a href="/@culture/landlords" class="hover:text-brand-600 dark:hover:text-brand-400">@L["footer.listProperty"]</a></li>
                    <li><a href="/@culture/signup" class="hover:text-brand-600 dark:hover:text-brand-400">@L["auth.createAccount"]</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-semibold text-slate-900 dark:text-white mb-3">@L["footer.about"]</h4>
                <ul class="space-y-2 text-slate-600 dark:text-white/60">
                    <li><a href="https://rent-ca.vercel.app/en" target="_blank" rel="noopener" class="hover:text-brand-600 dark:hover:text-brand-400">Next.js version</a></li>
                    <li><a href="https://github.com/grichaud/Rent.ca.NET" target="_blank" rel="noopener" class="hover:text-brand-600 dark:hover:text-brand-400">Source on GitHub</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-semibold text-slate-900 dark:text-white mb-3">@L["footer.terms"]</h4>
                <ul class="space-y-2 text-slate-600 dark:text-white/60">
                    <li><a href="/@culture/privacy" class="hover:text-brand-600 dark:hover:text-brand-400">@L["footer.privacy"]</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-gray-200 dark:border-white/10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 text-xs text-slate-500 dark:text-white/50 flex flex-col sm:flex-row items-center justify-between gap-2">
                <span>&copy; @DateTime.UtcNow.Year Rent.ca.NET &mdash; Portfolio build by Giovanni Richaud.</span>
                <span>Same product, two stacks.</span>
            </div>
        </div>
    </footer>

    <partial name="/Features/AiChat/Partials/_AiChatWidget.cshtml" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
