@page "/{culture:locale}"
@model Rent.Web.Features.Home.IndexModel
@{
    ViewData["Title"] = L["hero.title"].Value + " " + L["hero.titleHighlight"].Value;

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (culture != "en" && culture != "fr") { culture = "en"; }

    var quickCities = new[] { "Toronto", "Vancouver", "Montreal", "Calgary", "Ottawa", "Edmonton" };

    // Paridad Next.js (city-card.tsx CITY_GRADIENTS): gradiente fallback único por slug
    // cuando una ciudad no tiene foto. 12 ciudades + default.
    var cityGradients = new Dictionary<string, string>
    {
        ["toronto"] = "from-brand-900 via-brand-800 to-purple-900",
        ["vancouver"] = "from-cyan-900 via-teal-800 to-brand-900",
        ["montreal"] = "from-purple-900 via-brand-900 to-indigo-900",
        ["calgary"] = "from-amber-900 via-orange-900 to-brand-900",
        ["edmonton"] = "from-green-900 via-teal-900 to-brand-900",
        ["ottawa"] = "from-brand-950 via-brand-900 to-purple-900",
        ["winnipeg"] = "from-indigo-900 via-brand-900 to-cyan-900",
        ["quebec-city"] = "from-purple-950 via-purple-900 to-brand-900",
        ["hamilton"] = "from-slate-800 via-brand-900 to-teal-900",
        ["saskatoon"] = "from-amber-950 via-brand-900 to-orange-900",
        ["london"] = "from-brand-900 via-indigo-900 to-purple-900",
        ["halifax"] = "from-cyan-950 via-brand-900 to-teal-900",
    };
    string GradientFor(string slug) => cityGradients.TryGetValue(slug, out var g) ? g : "from-brand-900 to-purple-900";
}

<div class="space-y-24">

    <section aria-labelledby="popular-cities-heading">
        <div class="mb-10 flex items-end justify-between">
            <div>
                <p class="text-sm font-medium text-brand-400 uppercase tracking-widest mb-2">@L["cities.sectionLabel"]</p>
                <h2 id="popular-cities-heading" class="font-sans font-bold tracking-tight text-3xl sm:text-4xl text-slate-900 dark:text-white">@L["cities.sectionTitle"]</h2>
            </div>
            <p class="hidden sm:block text-slate-400 dark:text-white/50 text-sm">@string.Format(L["cities.available"].Value, Model.FeaturedCities.Count)</p>
        </div>

        <div class="grid gap-8 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
            @foreach (var city in Model.FeaturedCities)
            {
                <a href="/@culture/@city.Slug" class="group flex flex-col items-center gap-3">
                    <div class="relative">
                        <div aria-hidden="true" class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 blur-md bg-gradient-to-br from-brand-500/50 to-cyan-500/50 -m-1 transition-opacity"></div>
                        <div class="relative h-[120px] w-[120px] rounded-full border-2 border-gray-200 dark:border-white/20 group-hover:border-brand-400 dark:group-hover:border-brand-500/50 transition-all duration-300 group-hover:scale-105 shadow-xl overflow-hidden">
                            @if (!string.IsNullOrEmpty(city.ImageUrl))
                            {
                                <img src="@city.ImageUrl" alt="@city.Name" loading="lazy" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="h-full w-full bg-gradient-to-br @GradientFor(city.Slug) flex items-center justify-center">
                                    <span class="text-4xl font-bold text-white/80 select-none">@city.Name.Substring(0, 1)</span>
                                </div>
                            }
                            <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/10 to-transparent pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="text-center">
                        <p class="font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">@city.Name</p>
                        <p class="text-sm text-slate-400 dark:text-white/50">@city.Province</p>
                    </div>
                </a>
            }
        </div>
    </section>

    @if (Model.LatestListings.Count > 0)
    {
        <section aria-labelledby="new-listings-heading">
            <div class="flex items-end justify-between mb-8">
                <div>
                    <p class="text-sm font-medium text-brand-400 uppercase tracking-widest mb-2">@L["listings.justAdded"]</p>
                    <h2 id="new-listings-heading" class="font-sans font-bold tracking-tight text-3xl sm:text-4xl text-slate-900 dark:text-white">@L["listings.newListings"]</h2>
                </div>
                @* Paridad Next.js: `ROUTES.city('canada')` agrega todas las propiedades del país. *@
                <a href="/@culture/canada" class="glass-button !px-4 py-2 text-sm font-medium text-slate-600 dark:text-white/70 hover:text-slate-900 dark:hover:text-white inline-flex items-center gap-1.5">
                    <span>@L["common.viewAll"]</span>
                    <icon name="arrow-right" class="h-4 w-4" />
                </a>
            </div>

            <div class="relative">
                <button type="button" data-listings-scroll="left"
                        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 h-10 w-10 rounded-full hidden sm:flex items-center justify-center bg-black/40 hover:bg-black/60 border border-white/20 backdrop-blur-md text-white transition-colors"
                        aria-label="Scroll left">
                    <icon name="chevron-left" class="h-5 w-5" />
                </button>

                <div id="listings-track" class="flex gap-5 overflow-x-auto scroll-smooth pb-4 snap-x snap-mandatory" style="scrollbar-width:none" role="list" aria-label="New rental listings">
                    @foreach (var p in Model.LatestListings)
                    {
                        <div role="listitem" class="snap-start w-[300px] sm:w-[320px] flex-shrink-0">
                            <partial name="/Features/Search/Partials/_PropertyCard.cshtml" model="p" />
                        </div>
                    }
                </div>

                <button type="button" data-listings-scroll="right"
                        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 h-10 w-10 rounded-full hidden sm:flex items-center justify-center bg-black/40 hover:bg-black/60 border border-white/20 backdrop-blur-md text-white transition-colors"
                        aria-label="Scroll right">
                    <icon name="chevron-right" class="h-5 w-5" />
                </button>
            </div>
        </section>
    }

    @* Paridad Next.js stats-banner.tsx: count-up animation con IntersectionObserver.
       Valores hardcoded para coincidir con Next.js (10000, 200, 50000). El JS
       (`stats-counter.js`) anima 0 → target con easing cuando el bloque entra al viewport. *@
    <section id="stats-banner" aria-labelledby="stats-heading">
        <h2 id="stats-heading" class="sr-only">@L["stats.title"]</h2>
        <div class="grid gap-6 grid-cols-1 sm:grid-cols-3">
            <div class="glass-card-premium p-8 flex flex-col items-center text-center gap-4">
                <span class="glass-highlight"></span>
                <div class="h-14 w-14 rounded-2xl flex items-center justify-center bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                    <icon name="building-2" class="h-7 w-7 text-brand-400" />
                </div>
                <div>
                    <p class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white tabular-nums">
                        <span data-stat-counter data-target="10000" data-format="thousands">0</span><span class="ml-0.5 text-brand-400">K+</span>
                    </p>
                    <p class="mt-1 text-lg font-semibold text-slate-700 dark:text-white/90">@L["stats.activeListings"]</p>
                    <p class="mt-1 text-sm text-slate-400 dark:text-white/40">@L["stats.activeListingsDesc"]</p>
                </div>
            </div>

            <div class="glass-card-premium p-8 flex flex-col items-center text-center gap-4">
                <span class="glass-highlight"></span>
                <div class="h-14 w-14 rounded-2xl flex items-center justify-center bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                    <icon name="map-pin" class="h-7 w-7 text-cyan-400" />
                </div>
                <div>
                    <p class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white tabular-nums">
                        <span data-stat-counter data-target="200" data-format="raw">0</span><span class="ml-0.5 text-cyan-400">+</span>
                    </p>
                    <p class="mt-1 text-lg font-semibold text-slate-700 dark:text-white/90">@L["stats.citiesCovered"]</p>
                    <p class="mt-1 text-sm text-slate-400 dark:text-white/40">@L["stats.citiesCoveredDesc"]</p>
                </div>
            </div>

            <div class="glass-card-premium p-8 flex flex-col items-center text-center gap-4">
                <span class="glass-highlight"></span>
                <div class="h-14 w-14 rounded-2xl flex items-center justify-center bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10">
                    <icon name="users" class="h-7 w-7 text-purple-400" />
                </div>
                <div>
                    <p class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white tabular-nums">
                        <span data-stat-counter data-target="50000" data-format="thousands">0</span><span class="ml-0.5 text-purple-400">K+</span>
                    </p>
                    <p class="mt-1 text-lg font-semibold text-slate-700 dark:text-white/90">@L["stats.happyRenters"]</p>
                    <p class="mt-1 text-sm text-slate-400 dark:text-white/40">@L["stats.happyRentersDesc"]</p>
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="ai-cta-heading">
        @* Paridad Next.js ai-cta.tsx: background gradient extra + orb -top-20 -right-20 + animate-glow en icono. *@
        <div class="glass-card-premium p-10 sm:p-14 relative overflow-hidden">
            <span class="glass-highlight"></span>
            <div aria-hidden="true" class="absolute inset-0 rounded-3xl bg-gradient-to-br from-brand-500/10 via-transparent to-purple-500/10 pointer-events-none"></div>
            <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-brand-500/10 blur-3xl"></div>

            <div class="relative z-10 flex flex-col items-center text-center gap-6 max-w-2xl mx-auto">
                <div class="h-16 w-16 rounded-2xl flex items-center justify-center bg-gradient-to-br from-brand-500/30 to-cyan-500/30 border border-gray-300 dark:border-white/20 shadow-xl shadow-brand-500/20 animate-glow">
                    <icon name="sparkles" class="h-8 w-8 text-brand-400" />
                </div>

                <div>
                    <h2 id="ai-cta-heading" class="font-sans font-bold tracking-tight text-3xl sm:text-4xl text-slate-900 dark:text-white mb-3">@L["aiChat.cantFind"]</h2>
                    <p class="text-base sm:text-lg leading-relaxed text-slate-500 dark:text-white/60">@L["aiChat.cantFindDesc"]</p>
                </div>

                <button type="button" id="ai-cta-button" class="glass-button-primary group inline-flex items-center gap-3 !px-8 !py-4 text-base font-semibold text-white">
                    <icon name="sparkles" class="h-5 w-5 text-brand-300 shrink-0" />
                    <span>@L["aiChat.chatButton"]</span>
                    <icon name="arrow-right" class="h-4 w-4 text-white/60 transition-transform duration-300 group-hover:translate-x-1" />
                </button>

                <div class="flex items-center gap-6 text-sm text-gray-400 dark:text-white/40">
                    <span>@L["aiChat.freeToUse"]</span>
                    <span class="h-px w-4 bg-gray-300 dark:bg-white/20"></span>
                    <span>@L["aiChat.noSignup"]</span>
                    <span class="h-px w-4 bg-gray-300 dark:bg-white/20"></span>
                    <span>@L["aiChat.available247"]</span>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="glass-card-premium p-10 sm:p-14 text-center">
            <span class="glass-highlight"></span>
            <icon name="building" class="h-10 w-10 mx-auto text-brand-500 mb-4" />
            <h2 class="font-sans font-bold tracking-tight text-3xl sm:text-4xl text-slate-900 dark:text-white">
                @L["landlordPage.title"] <span class="bg-gradient-to-r from-brand-500 to-cyan-500 dark:from-brand-400 dark:to-cyan-400 bg-clip-text text-transparent">@L["landlordPage.titleHighlight"]</span>
            </h2>
            <p class="text-slate-600 dark:text-white/70 mt-3 max-w-xl mx-auto">@L["landlordPage.subtitle"]</p>
            <a href="/@culture/landlords" class="glass-button-primary inline-flex items-center gap-2 mt-8">
                <span>@L["landlordPage.getStarted"]</span>
                <icon name="user-plus" class="h-4 w-4" />
            </a>
        </div>
    </section>

</div>

@section Hero {
    @* Paridad Next.js: hero `min-h-[90vh]` con padding generoso. *@
    <section class="relative overflow-hidden min-h-[90vh] flex flex-col items-center justify-center px-4 py-24" aria-label="@L["hero.title"] @L["hero.titleHighlight"]">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1517935706615-2717063c2225?w=1920&amp;h=1080&amp;fit=crop&amp;q=80"
                 alt=""
                 class="absolute inset-0 w-full h-full object-cover"
                 loading="eager"
                 fetchpriority="high" />
            <div class="absolute inset-0 bg-white/40 dark:bg-slate-950/60"></div>
            <div class="absolute inset-0 mesh-background opacity-40 dark:opacity-60"></div>
        </div>

        <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-[1]">
            <div class="absolute -top-[10%] -left-[5%] h-[600px] w-[600px] rounded-full bg-brand-500/10 dark:bg-brand-500/15 blur-[120px] animate-pulse-slow"></div>
            <div class="absolute -top-[5%] -right-[10%] h-[500px] w-[500px] rounded-full bg-purple-500/10 dark:bg-purple-500/15 blur-[100px] animate-pulse-slow [animation-delay:2s]"></div>
            <div class="absolute bottom-[5%] left-[30%] h-[400px] w-[400px] rounded-full bg-cyan-500/10 dark:bg-cyan-500/15 blur-[80px] animate-pulse-slow [animation-delay:4s]"></div>
        </div>

        <div aria-hidden="true" class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-gray-50 dark:from-slate-950 to-transparent pointer-events-none z-[2]"></div>

        <div class="relative z-10 w-full max-w-4xl mx-auto px-4 py-16 sm:py-24 text-center">
            <div class="glass-badge mx-auto mb-8 inline-flex">
                <icon name="sparkles" class="h-3.5 w-3.5 text-brand-600 dark:text-brand-300" />
                <span class="text-xs font-medium text-slate-700 dark:text-white/80">@L["hero.badge"]</span>
            </div>

            <h1 class="font-sans font-bold tracking-tight text-5xl sm:text-6xl md:text-7xl leading-[1.05] text-slate-900 dark:text-white">
                @L["hero.title"]
                <span class="bg-gradient-to-r from-brand-500 to-cyan-500 dark:from-brand-400 dark:to-cyan-400 bg-clip-text text-transparent">@L["hero.titleHighlight"]</span>
            </h1>
            <p class="text-lg sm:text-xl text-slate-600 dark:text-white/70 mt-6 max-w-2xl mx-auto">@L["hero.subtitle"]</p>

            @* Paridad Next.js hero-section.tsx: search bar `glass-base` (no `glass-card`),
               padding generoso `px-6 py-4`, sombras 2xl, sin segundo icono en el botón. *@
            <form id="hero-search" class="mt-10 max-w-2xl mx-auto glass-base flex items-center gap-3 px-6 py-4 focus-within:border-brand-500/40 dark:focus-within:border-white/40 transition-all duration-300 shadow-2xl shadow-black/10 dark:shadow-black/30" role="search">
                <icon name="search" class="h-5 w-5 shrink-0 text-gray-400 dark:text-white/40" />
                <input type="search" id="hero-city" name="q" required autocomplete="off"
                       placeholder="@L["hero.searchPlaceholder"]"
                       aria-label="@L["hero.searchPlaceholder"]"
                       class="flex-1 bg-transparent border-0 outline-none text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-white/40 text-base focus:ring-0 px-4 py-1" />
                <button type="submit" class="glass-button-primary !px-5 !py-2.5 text-sm font-semibold shrink-0" aria-label="Search rentals">
                    <span>@L["common.search"]</span>
                </button>
            </form>

            @* Paridad Next.js: AI CTA como `glass-button` (rounded-xl + px-5 py-2.5), no como badge. *@
            <div class="mt-4 flex justify-center">
                <button type="button" id="hero-ai-cta" class="glass-button group inline-flex items-center gap-2 !px-5 !py-2.5 text-sm text-slate-600 hover:text-slate-900 dark:text-white/70 dark:hover:text-white" aria-label="@L["hero.aiCta"]">
                    <icon name="sparkles" class="h-4 w-4 text-brand-500 dark:text-brand-400 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors duration-300" />
                    <span>@L["hero.aiCta"]</span>
                </button>
            </div>

            <nav class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Popular cities">
                @foreach (var name in quickCities)
                {
                    var slug = name.ToLowerInvariant().Replace(" ", "-");
                    <a href="/@culture/@slug" class="glass-badge text-slate-600 hover:text-slate-900 hover:bg-gray-200/50 dark:text-white/70 dark:hover:text-white dark:hover:bg-white/20 transition-all duration-200">@name</a>
                }
            </nav>
        </div>
    </section>
}

@section Scripts {
    <script>
      var culturePrefix = '/@culture';
      function slugify(text) {
        return text.toLowerCase()
          .normalize('NFD').replace(/[̀-ͯ]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)+/g, '');
      }
      document.getElementById('hero-search').addEventListener('submit', function (e) {
        e.preventDefault();
        var slug = slugify((document.getElementById('hero-city').value || '').trim());
        if (slug) window.location.href = culturePrefix + '/' + slug;
      });

      function openAiChatPanel() {
        var trigger = document.getElementById('ai-chat-trigger');
        if (trigger) trigger.click();
      }
      var heroAiCta = document.getElementById('hero-ai-cta');
      if (heroAiCta) heroAiCta.addEventListener('click', openAiChatPanel);
      var ctaButton = document.getElementById('ai-cta-button');
      if (ctaButton) ctaButton.addEventListener('click', openAiChatPanel);

      var track = document.getElementById('listings-track');
      if (track) {
        var step = 320;
        document.querySelectorAll('[data-listings-scroll]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var dir = btn.getAttribute('data-listings-scroll') === 'left' ? -1 : 1;
            track.scrollBy({ left: dir * step, behavior: 'smooth' });
          });
        });
      }
    </script>
    <style>
      #listings-track::-webkit-scrollbar { display: none; }
    </style>
}
