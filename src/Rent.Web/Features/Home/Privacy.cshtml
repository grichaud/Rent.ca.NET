@page "/{culture:locale}/privacy"
@model Rent.Web.Features.Home.PrivacyModel
@{
    ViewData["Title"] = L["footer.privacy"].Value;
}

<section class="max-w-2xl mx-auto glass-card p-10">
    <h1 class="font-display text-3xl text-slate-900 dark:text-white">@L["footer.privacy"]</h1>
    <p class="text-slate-600 dark:text-white/70 mt-4">
        @L["footer.privacyText"] <a href="https://github.com/grichaud" class="text-brand-600 dark:text-brand-400 underline">@L["footer.privacyRepo"]</a>.
    </p>
</section>
