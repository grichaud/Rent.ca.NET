@page "/{culture:locale}/faq"
@model Rent.Web.Features.Home.FaqModel
@{
    ViewData["Title"] = L["Faq_Title"].Value;
}

<section class="max-w-3xl mx-auto" aria-labelledby="faq-heading">
    <div class="text-center py-8">
        <h1 id="faq-heading" class="font-sans font-bold tracking-tight text-4xl text-slate-900 dark:text-white">@L["Faq_Title"]</h1>
        <p class="text-lg text-slate-600 dark:text-white/70 mt-4">@L["Faq_Subtitle"]</p>
    </div>

    <div class="mt-4 space-y-3">
        @foreach (var item in Model.Items)
        {
            <details class="faq-item glass-card group">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 select-none">
                    <span class="font-medium text-slate-900 dark:text-white">@L[item.QuestionKey]</span>
                    <icon name="chevron-down" class="faq-chevron h-4 w-4 text-slate-500 dark:text-white/60 transition-transform duration-300" />
                </summary>
                <div class="px-5 pb-5 text-sm text-slate-600 dark:text-white/70 leading-relaxed">
                    @L[item.AnswerKey]
                </div>
            </details>
        }
    </div>
</section>
