@page "/landlords"
@model Rent.Web.Features.Home.LandlordsLandingModel
@{
    ViewData["Title"] = "For landlords";
}

<section class="max-w-3xl mx-auto text-center py-12">
    <h1 class="font-display text-5xl text-slate-900">List your rental on Rent.ca</h1>
    <p class="text-lg text-slate-600 mt-4">Reach thousands of renters across Canada. Free to post your first listing.</p>
    <div class="mt-8 flex items-center justify-center gap-3">
        <a href="/signup" class="glass-button-primary">Get started free</a>
        <a href="/login" class="glass-button">I already have an account</a>
    </div>
</section>
